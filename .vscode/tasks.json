{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "engine: build",
            "detail": "Builds the Rust engine and stages it with its runtime libraries into engine/dist (the app's dev engine).",
            "type": "shell",
            "command": "bash scripts/fetch-runtime.sh && cargo build --release -p se-cli && bash scripts/stage-runtime.sh",
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "silent"
            },
            "windows": {
                "dependsOn": [
                    "windows: engine build"
                ],
                "command": "echo engine staged"
            }
        },
        {
            "label": "app: build",
            "type": "shell",
            "command": "swift build --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare (engine + app)",
            "dependsOn": [
                "engine: build",
                "app: build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "app: build release",
            "type": "shell",
            "command": "swift build -c release --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare release (engine + app)",
            "dependsOn": [
                "engine: build",
                "app: build release"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "macOS: release (.app)",
            "detail": "Full macOS release: Swift release build + Rust engine (cargo + engine/scripts/stage-runtime.sh), assembled and signed as build/Subtitle Adder.app (scripts/package-macos.sh).",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release (.app, quick)",
            "detail": "Same as 'macOS: release (.app)' but reuses the already staged engine (engine/dist); use when only Swift code changed.",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
                    "SKIP_ENGINE_BUILD": "1"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release DMG",
            "detail": "Full macOS release plus build/Subtitle Adder.dmg (ad-hoc signed unless SIGN_IDENTITY is set).",
            "type": "shell",
            "command": "MAKE_DMG=1 \"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run app",
            "type": "shell",
            "command": "swift run SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "dependsOn": [
                "engine: build"
            ],
            "problemMatcher": [
                "$swiftc"
            ],
            "isBackground": false
        },
        {
            "label": "Tests (engine + app)",
            "type": "shell",
            "command": "(cd engine && cargo test --workspace) && (cd apps/macos && swift test)",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "End-to-end test (real engine)",
            "type": "shell",
            "command": "ENGINE_E2E=1 swift test --filter realEngineOnDemoVideo",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "windows: engine build",
            "detail": "Builds the Rust engine and stages it with its runtime DLLs into engine/dist, where the dev app finds it; skipped when engine/dist is newer than the engine sources (engine/scripts/build-dev.ps1).",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/engine/scripts/build-dev.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": "$rustc",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "windows: engine test",
            "type": "process",
            "command": "pwsh.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "$PSNativeCommandUseErrorActionPreference = $true; $ErrorActionPreference = 'Stop'; if (-not $env:FFMPEG_DIR) { $env:FFMPEG_DIR = '${workspaceFolder}/engine/.runtime/ffmpeg' }; cargo test --workspace -j 2"
            ],
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": "$rustc",
            "group": "test"
        },
        {
            "label": "windows: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/apps/windows/src/SubtitleAdder/SubtitleAdder.csproj",
                "-p:Platform=x64",
                "-p:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "dependsOn": [
                "windows: engine build"
            ],
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "windows: test",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/apps/windows/SubtitleAdder.slnx",
                "-p:Platform=x64"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "windows: end-to-end test (real engine)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/apps/windows/SubtitleAdder.slnx",
                "-p:Platform=x64"
            ],
            "dependsOn": [
                "windows: engine build"
            ],
            "options": {
                "env": {
                    "ENGINE_E2E": "1"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "windows: package",
            "type": "shell",
            "command": "pwsh.exe -NoProfile -File \"${workspaceFolder}/scripts/package-windows.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "windows: publish",
            "type": "shell",
            "command": "pwsh.exe -NoProfile -File \"${workspaceFolder}/scripts/package-windows.ps1\" -Zip",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
