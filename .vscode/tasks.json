{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "engine: build",
            "detail": "Builds the Rust engine and stages it with its runtime libraries into engine/dist (the app's dev engine).",
            "type": "shell",
            "command": "bash scripts/fetch-runtime.sh && cargo build --release -p se-cli && bash scripts/stage-runtime.sh",
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "silent"
            },
            "windows": {
                "dependsOn": [
                    "windows: engine build"
                ],
                "command": "echo engine staged"
            }
        },
        {
            "label": "app: build",
            "type": "shell",
            "command": "swift build --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare (engine + app)",
            "dependsOn": [
                "engine: build",
                "app: build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "app: build release",
            "type": "shell",
            "command": "swift build -c release --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare release (engine + app)",
            "dependsOn": [
                "engine: build",
                "app: build release"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "macOS: release (.app)",
            "detail": "Full macOS release: Swift release build + Rust engine (cargo + engine/scripts/stage-runtime.sh), assembled and signed as build/Subtitle Adder.app (scripts/package-macos.sh).",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release (.app, quick)",
            "detail": "Same as 'macOS: release (.app)' but reuses the already staged engine (engine/dist); use when only Swift code changed.",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
                    "SKIP_ENGINE_BUILD": "1"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release DMG",
            "detail": "Full macOS release plus build/Subtitle Adder.dmg (ad-hoc signed unless SIGN_IDENTITY is set).",
            "type": "shell",
            "command": "MAKE_DMG=1 \"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.cargo/bin:${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run app",
            "type": "shell",
            "command": "swift run SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "dependsOn": [
                "engine: build"
            ],
            "problemMatcher": [
                "$swiftc"
            ],
            "isBackground": false
        },
        {
            "label": "Tests (engine + app)",
            "type": "shell",
            "command": "(cd engine && cargo test --workspace) && (cd apps/macos && swift test)",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "End-to-end test (real engine)",
            "type": "shell",
            "command": "ENGINE_E2E=1 swift test --filter realEngineOnDemoVideo",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "windows: engine build",
            "detail": "Builds the Rust engine and stages it with its runtime DLLs into engine/dist, where the dev app finds it; skipped when engine/dist is newer than the engine sources (engine/scripts/build-dev.ps1).",
            "type": "process",
            "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/engine/scripts/build-dev.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": "$rustc",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "windows: engine test",
            "type": "process",
            "command": "pwsh.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "$PSNativeCommandUseErrorActionPreference = $true; $ErrorActionPreference = 'Stop'; if (-not $env:FFMPEG_DIR) { $env:FFMPEG_DIR = '${workspaceFolder}/engine/.runtime/ffmpeg' }; cargo test --workspace -j 2"
            ],
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": "$rustc",
            "group": "test"
        },
        {
            "label": "desktop: run (Windows)",
            "detail": "Builds and stages the Rust desktop app when its sources changed (apps/desktop/dist) and starts it.",
            "type": "process",
            "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/apps/desktop/scripts/run.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "desktop: release (Windows)",
            "detail": "Packages the Rust desktop app in release (build/desktop/Subtitle Adder + zip) and starts the packaged app.",
            "type": "process",
            "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/apps/desktop/scripts/release.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "desktop: run (macOS)",
            "detail": "Builds the engine when needed and the Rust desktop app in release, then starts it.",
            "type": "shell",
            "command": "bash \"${workspaceFolder}/apps/desktop/scripts/run.sh\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "desktop: release (macOS)",
            "detail": "Packages the Rust desktop app as build/desktop/Subtitle Adder.app (signed inside-out) and opens it.",
            "type": "shell",
            "command": "bash \"${workspaceFolder}/apps/desktop/scripts/release.sh\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "desktop (Rust): stage",
            "detail": "Builds the Rust desktop app (release) and stages apps/desktop/dist: SubtitleAdder.exe, the FFmpeg DLLs and the engine from engine/dist; skipped when dist is newer than the desktop sources (apps/desktop/scripts/stage.ps1).",
            "type": "process",
            "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/apps/desktop/scripts/stage.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/desktop",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "dependsOn": [
                "windows: engine build"
            ],
            "problemMatcher": "$rustc",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "desktop: test (Windows)",
            "detail": "cargo test --workspace for the Rust desktop app (apps/desktop), in the shared target dir with line-tables-only debug info.",
            "type": "process",
            "command": "pwsh.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "$PSNativeCommandUseErrorActionPreference = $true; $ErrorActionPreference = 'Stop'; if (-not $env:CARGO_TARGET_DIR) { $env:CARGO_TARGET_DIR = Join-Path $env:USERPROFILE '.subtitle-adder-desktop-target' }; if (-not $env:FFMPEG_DIR) { $env:FFMPEG_DIR = '${workspaceFolder}/engine/.runtime/ffmpeg' }; $env:Path = (Join-Path $env:FFMPEG_DIR 'bin') + ';' + $env:Path; $env:CARGO_INCREMENTAL = '0'; $env:CARGO_PROFILE_DEV_DEBUG = 'line-tables-only'; cargo test --workspace -j 3"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/desktop",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "problemMatcher": "$rustc",
            "group": "test"
        },
        {
            "label": "desktop: end-to-end test (Windows)",
            "detail": "Stages the Rust desktop app and drives it through UI Automation on a copy of the frozen C# data (apps/desktop/scripts/e2e-windows.ps1, root C:\\SubtitleAdderE2E; whisper base and madlad-3b must be cached).",
            "type": "process",
            "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/apps/desktop/scripts/e2e-windows.ps1",
                "-Root",
                "C:\\SubtitleAdderE2E"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/desktop",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:Path}"
                }
            },
            "dependsOn": [
                "desktop (Rust): stage"
            ],
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
