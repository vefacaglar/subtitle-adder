{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "engine: uv sync",
            "type": "shell",
            "command": "uv sync",
            "options": {
                "cwd": "${workspaceFolder}/engine",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            },
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}/engine",
                    "env": {
                        "PATH": "${env:USERPROFILE}\\.local\\bin;${env:APPDATA}\\Python\\Python312\\Scripts;${env:LOCALAPPDATA}\\Microsoft\\WindowsApps;${env:Path}"
                    }
                },
                "command": "uv sync --group cuda"
            }
        },
        {
            "label": "app: build",
            "type": "shell",
            "command": "swift build --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare (engine + app)",
            "dependsOn": [
                "engine: uv sync",
                "app: build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "app: build release",
            "type": "shell",
            "command": "swift build -c release --product SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "problemMatcher": [
                "$swiftc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Prepare release (engine + app)",
            "dependsOn": [
                "engine: uv sync",
                "app: build release"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "macOS: release (.app)",
            "detail": "Full macOS release: Swift release build + PyInstaller engine, assembled and signed as build/Subtitle Adder.app (scripts/package-macos.sh).",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release (.app, quick)",
            "detail": "Same as 'macOS: release (.app)' but reuses the already built engine (build/engine-dist); use when only Swift code changed.",
            "type": "shell",
            "command": "\"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
                    "SKIP_ENGINE_BUILD": "1"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "macOS: release DMG",
            "detail": "Full macOS release plus build/Subtitle Adder.dmg (ad-hoc signed unless SIGN_IDENTITY is set).",
            "type": "shell",
            "command": "MAKE_DMG=1 \"${workspaceFolder}/scripts/package-macos.sh\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run app",
            "type": "shell",
            "command": "swift run SubtitleAdderApp",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "dependsOn": [
                "engine: uv sync"
            ],
            "problemMatcher": [
                "$swiftc"
            ],
            "isBackground": false
        },
        {
            "label": "Tests (engine + app)",
            "type": "shell",
            "command": "(cd engine && uv run pytest) && (cd apps/macos && swift test)",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "End-to-end test (real engine)",
            "type": "shell",
            "command": "ENGINE_E2E=1 swift test --filter realEngineOnDemoVideo",
            "options": {
                "cwd": "${workspaceFolder}/apps/macos",
                "env": {
                    "PATH": "${env:HOME}/.local/bin:/opt/homebrew/bin:${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": [
                "$swiftc"
            ]
        },
        {
            "label": "windows: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/apps/windows/src/SubtitleAdder/SubtitleAdder.csproj",
                "-p:Platform=x64",
                "-p:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "dependsOn": [
                "engine: uv sync"
            ],
            "problemMatcher": "$msCompile",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "windows: test",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/apps/windows/SubtitleAdder.slnx",
                "-p:Platform=x64"
            ],
            "options": {
                "env": {
                    "PATH": "${env:USERPROFILE}\\.local\\bin;${env:APPDATA}\\Python\\Python312\\Scripts;${env:LOCALAPPDATA}\\Microsoft\\WindowsApps;${env:Path}"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "windows: end-to-end test (real engine)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/apps/windows/SubtitleAdder.slnx",
                "-p:Platform=x64"
            ],
            "options": {
                "env": {
                    "PATH": "${env:USERPROFILE}\\.local\\bin;${env:APPDATA}\\Python\\Python312\\Scripts;${env:LOCALAPPDATA}\\Microsoft\\WindowsApps;${env:Path}",
                    "ENGINE_E2E": "1"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "windows: package",
            "type": "shell",
            "command": "pwsh.exe -NoProfile -File \"${workspaceFolder}/scripts/package-windows.ps1\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.local\\bin;${env:APPDATA}\\Python\\Python312\\Scripts;${env:LOCALAPPDATA}\\Microsoft\\WindowsApps;${env:Path}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "windows: publish",
            "type": "shell",
            "command": "pwsh.exe -NoProfile -File \"${workspaceFolder}/scripts/package-windows.ps1\" -Zip",
            "dependsOn": [
                "engine: uv sync"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.local\\bin;${env:APPDATA}\\Python\\Python312\\Scripts;${env:LOCALAPPDATA}\\Microsoft\\WindowsApps;${env:Path}"
                }
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
