{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Publish (macOS)",
            "type": "node-terminal",
            "request": "launch",
            "command": "MAKE_DMG=1 \"${workspaceFolder}/scripts/package-macos.sh\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Publish (Windows)",
            "type": "node-terminal",
            "request": "launch",
            "command": "pwsh.exe -NoProfile -File \"${workspaceFolder}/scripts/package-windows.ps1\" -Zip",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "engine: uv sync"
        },
        {
            "name": "Subtitle Adder (Windows)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/apps/windows/src/SubtitleAdder/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64/SubtitleAdder.exe",
            "args": [],
            "cwd": "${workspaceFolder}/apps/windows/src/SubtitleAdder",
            "console": "internalConsole",
            "stopAtEntry": false,
            "preLaunchTask": "windows: build"
        },
        {
            "name": "Subtitle Adder (macOS)",
            "type": "swift",
            "request": "launch",
            "program": "${workspaceFolder}/apps/macos/.build/debug/SubtitleAdderApp",
            "cwd": "${workspaceFolder}/apps/macos",
            "args": [],
            "preLaunchTask": "Prepare (engine + app)"
        },
        {
            "name": "Engine: process demo video (Python)",
            "type": "debugpy",
            "request": "launch",
            "module": "subtitle_engine.cli",
            "args": [
                "transcribe",
                "${workspaceFolder}/samples/demo.mp4",
                "-m",
                "base",
                "-l",
                "tr",
                "-o",
                "${workspaceFolder}/output",
                "-f",
                "srt",
                "vtt",
                "json"
            ],
            "cwd": "${workspaceFolder}/engine",
            "python": "${workspaceFolder}/engine/.venv/bin/python",
            "justMyCode": true,
            "console": "integratedTerminal",
            "preLaunchTask": "engine: uv sync",
            "windows": {
                "python": "${workspaceFolder}/engine/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "Engine: tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "cwd": "${workspaceFolder}/engine",
            "python": "${workspaceFolder}/engine/.venv/bin/python",
            "console": "integratedTerminal",
            "preLaunchTask": "engine: uv sync",
            "windows": {
                "python": "${workspaceFolder}/engine/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "Subtitle Adder (macOS, release)",
            "type": "swift",
            "request": "launch",
            "configuration": "release",
            "program": "${workspaceFolder}/build/Subtitle Adder.app/Contents/MacOS/SubtitleAdderApp",
            "cwd": "${workspaceFolder}",
            "args": [],
            "preLaunchTask": "macOS: release (.app)"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:subtitle-adder}/apps/macos",
            "name": "Debug SubtitleAdderApp (apps/macos)",
            "target": "SubtitleAdderApp",
            "configuration": "debug",
            "preLaunchTask": "swift: Build Debug SubtitleAdderApp (apps/macos)"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:subtitle-adder}/apps/macos",
            "name": "Release SubtitleAdderApp (apps/macos)",
            "target": "SubtitleAdderApp",
            "configuration": "release",
            "preLaunchTask": "swift: Build Release SubtitleAdderApp (apps/macos)"
        }
    ]
}
