{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Publish (macOS)",
            "type": "node-terminal",
            "request": "launch",
            "command": "MAKE_DMG=1 \"${workspaceFolder}/scripts/package-macos.sh\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Run (Windows)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/apps/desktop/scripts/run.ps1\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Release (Windows)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/apps/desktop/scripts/release.ps1\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Run (macOS)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash \"${workspaceFolder}/apps/desktop/scripts/run.sh\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Release (macOS)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bash \"${workspaceFolder}/apps/desktop/scripts/release.sh\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Subtitle Adder (macOS)",
            "type": "swift",
            "request": "launch",
            "program": "${workspaceFolder}/apps/macos/.build/debug/SubtitleAdderApp",
            "cwd": "${workspaceFolder}/apps/macos",
            "args": [],
            "preLaunchTask": "Prepare (engine + app)"
        },
        {
            "name": "Subtitle Adder (macOS, release)",
            "type": "swift",
            "request": "launch",
            "configuration": "release",
            "program": "${workspaceFolder}/build/Subtitle Adder.app/Contents/MacOS/SubtitleAdderApp",
            "cwd": "${workspaceFolder}",
            "args": [],
            "preLaunchTask": "macOS: release (.app)"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:subtitle-adder}/apps/macos",
            "name": "Debug SubtitleAdderApp (apps/macos)",
            "target": "SubtitleAdderApp",
            "configuration": "debug",
            "preLaunchTask": "swift: Build Debug SubtitleAdderApp (apps/macos)"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:subtitle-adder}/apps/macos",
            "name": "Release SubtitleAdderApp (apps/macos)",
            "target": "SubtitleAdderApp",
            "configuration": "release",
            "preLaunchTask": "swift: Build Release SubtitleAdderApp (apps/macos)"
        }
    ]
}
