// SentenceEditorView (mac-ui §7.6): empty states, the small-control edit bar (three layouts by width: one row with
// "Şimdiki an", one row without it, two rows), a 1 pt divider and the multi-selection line table with plain
// multi-line fields, accent selection highlight (gray when the table is not focused), speaker menus and context menus.
import { ListView, Spinner } from "std-widgets.slint";
import { Loc } from "../../shared/loc.slint";
import { MainBridge } from "../../shared/bridge.slint";
import { SentenceRowData } from "../../shared/main_types.slint";
import { MacTheme } from "../theme.slint";
import { Sym, PushButton, MacMenu, ToolTip } from "controls.slint";

// Plain borderless field (1…max lines growing). Return commits.
component PlainField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <brush> text-color: MacTheme.label;
    in property <length> font-size: MacTheme.body-size;
    in property <length> max-box-height: 4 * 17px;
    in property <bool> enabled: true;
    callback focus-changed(bool);
    callback edited(string);
    callback committed();
    height: min(input.preferred-height, root.max-box-height);
    clip: true;
    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-value: input.text;
    FocusScope {
        capture-key-pressed(e) => {
            if (input.has-focus && e.text == Key.Return && !e.modifiers.meta) {
                root.committed();
                return accept;
            }
            reject
        }
        input := TextInput {
            text: root.value;
            enabled: root.enabled;
            wrap: word-wrap;
            single-line: false;
            font-size: root.font-size;
            color: root.text-color;
            selection-background-color: MacTheme.control-accent.with-alpha(0.35);
            edited => { if (self.has-focus) { root.edited(self.text); } }
            changed has-focus => { root.focus-changed(self.has-focus); }
        }
    }
    if input.text == "": Text {
        text: root.placeholder;
        font-size: root.font-size;
        color: MacTheme.tertiary-label;
    }
    changed value => {
        if (!input.has-focus) {
            input.text = root.value;
        }
    }
}

component Marker inherits Rectangle {
    in property <string> symbol;
    in property <string> tooltip;
    in property <string> title;
    width: 12px;
    height: 14px;
    accessible-role: text;
    accessible-label: root.title;
    Sym {
        y: 2px;
        name: root.symbol;
        size: 10px;
        tint: MacTheme.system-orange;
    }
    touch := TouchArea { }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover;
    }
}

component SpeakerMenuButton inherits Rectangle {
    in property <int> index;
    in property <SentenceRowData> item;
    in property <bool> selected-look;
    width: 124px;
    height: 18px;
    accessible-role: combobox;
    accessible-label: root.item.speaker-text;
    accessible-description: Loc.t("Konuşmacıyı değiştir");
    HorizontalLayout {
        spacing: 5px;
        alignment: start;
        if root.item.has-speaker: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: 4px;
            background: root.item.speaker-color;
        }
        Text {
            text: root.item.speaker-text;
            font-size: MacTheme.caption-size;
            vertical-alignment: center;
            overflow: elide;
            color: root.selected-look ? white : (root.item.has-speaker ? MacTheme.label : MacTheme.secondary-label);
        }
        Sym {
            y: (parent.height - self.height) / 2;
            name: "chevron.down";
            size: 7px;
            tint: root.selected-look ? white : MacTheme.secondary-label;
        }
    }
    touch := TouchArea {
        clicked => {
            MainBridge.speaker-clicked(root.index);
            MainBridge.menu-requested("speaker:" + root.index);
            menu.show();
        }
    }
    ToolTip {
        text: Loc.t("Bu satırı söyleyen kişiyi değiştir");
        show: touch.has-hover && !touch.pressed;
    }
    menu := MacMenu {
        x: 0;
        y: root.height + 2px;
        min-menu-width: 180px;
    }
}

component TableRow inherits Rectangle {
    in property <int> index;
    in property <SentenceRowData> item;
    in property <bool> shows-speakers;
    in property <bool> list-focused;
    callback context(length, length);
    callback grab-focus();
    property <bool> sel: root.item.is-selected;
    property <bool> emph: root.sel && root.list-focused;
    min-height: 24px;
    accessible-role: list-item;
    accessible-label: root.item.accessible-label;
    accessible-item-selected: root.sel;
    border-radius: 5px;
    background: root.emph ? MacTheme.control-accent : root.sel ? MacTheme.unemphasized-selection : transparent;
    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !e.modifiers.control) {
                root.grab-focus();
                MainBridge.row-pressed(root.index, e.modifiers.meta, e.modifiers.shift);
            } else if (e.kind == PointerEventKind.down && (e.button == PointerEventButton.right || (e.button == PointerEventButton.left && e.modifiers.control))) {
                MainBridge.row-context(root.index);
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    // Active (playing) line: accent 16 % radius 5.
    if root.item.is-active && !root.emph: Rectangle {
        border-radius: 5px;
        background: MacTheme.control-accent.with-alpha(0.16);
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 10px;
        Text {
            width: 28px;
            text: root.item.number;
            horizontal-alignment: right;
            vertical-alignment: top;
            font-size: MacTheme.body-size;
            color: root.emph ? white : root.item.is-active ? MacTheme.control-accent : MacTheme.secondary-label;
        }
        Text {
            width: 124px;
            text: root.item.time-text;
            vertical-alignment: top;
            font-size: MacTheme.caption-size;
            color: root.emph ? #ffffffcc : MacTheme.secondary-label;
        }
        if root.shows-speakers: VerticalLayout {
            alignment: start;
            SpeakerMenuButton {
                index: root.index;
                item: root.item;
                selected-look: root.emph;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                spacing: 5px;
                PlainField {
                    horizontal-stretch: 1;
                    value: root.item.text;
                    placeholder: Loc.t("Cümle");
                    enabled: !MainBridge.is-working;
                    text-color: root.emph ? white : MacTheme.label;
                    focus-changed(f) => { MainBridge.text-focus(root.index, false, f); MainBridge.editing-changed(f); }
                    edited(t) => { MainBridge.text-edited(root.index, false, t); }
                    committed => { MainBridge.text-commit(root.index, false); }
                }
                if !root.item.has-translation && root.item.needs-review: Marker {
                    symbol: "exclamationmark.triangle";
                    title: Loc.t("Çeviriyi kontrol et");
                    tooltip: Loc.t("Bu satır çevrilemedi. Seçip yeniden çevirebilir veya elle düzeltebilirsin.");
                }
            }
            if root.item.has-translation: HorizontalLayout {
                spacing: 5px;
                Sym {
                    name: "character.bubble";
                    size: 10px;
                    tint: root.emph ? #ffffffcc : MacTheme.secondary-label;
                    accessible-role: text;
                    accessible-label: Loc.t("Çeviri");
                }
                PlainField {
                    horizontal-stretch: 1;
                    value: root.item.translation-text;
                    placeholder: Loc.t("Çeviri");
                    max-box-height: 3 * 17px;
                    enabled: !MainBridge.is-working;
                    text-color: root.emph ? #ffffffd9 : MacTheme.secondary-label;
                    focus-changed(f) => { MainBridge.text-focus(root.index, true, f); MainBridge.editing-changed(f); }
                    edited(t) => { MainBridge.text-edited(root.index, true, t); }
                    committed => { MainBridge.text-commit(root.index, true); }
                }
                if root.item.is-stale: Marker {
                    symbol: "clock.arrow.circlepath";
                    title: Loc.t("Çeviri eski");
                    tooltip: Loc.t("Orijinal metin değişti; çeviri eski olabilir. “Çevir…” ile yenile.");
                }
                if root.item.needs-review: Marker {
                    symbol: "exclamationmark.triangle";
                    title: Loc.t("Çeviriyi kontrol et");
                    tooltip: Loc.t("Bu satır çevrilemedi. Seçip yeniden çevirebilir veya elle düzeltebilirsin.");
                }
            }
        }
    }
}

component Timing inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    in property <int> edge;
    in property <bool> caption;
    in property <bool> scope;
    spacing: 4px;
    if root.caption: Text {
        text: root.title;
        font-size: MacTheme.small-size;
        color: MacTheme.secondary-label;
        vertical-alignment: center;
    }
    PushButton {
        small: true;
        symbol: "minus";
        enabled: MainBridge.timing-enabled;
        accessible-name: Loc.t1("%@ 0,1 sn geri", root.title);
        clicked => { MainBridge.nudge(root.edge, -0.1); }
    }
    Text {
        min-width: 52px;
        text: root.value;
        font-size: MacTheme.small-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: MainBridge.timing-enabled ? MacTheme.label : MacTheme.tertiary-label;
    }
    PushButton {
        small: true;
        symbol: "plus";
        enabled: MainBridge.timing-enabled;
        accessible-name: Loc.t1("%@ 0,1 sn ileri", root.title);
        clicked => { MainBridge.nudge(root.edge, 0.1); }
    }
    if root.scope: PushButton {
        small: true;
        symbol: "scope";
        enabled: MainBridge.timing-enabled;
        accessible-name: Loc.t("Şimdiki an");
        tooltip: Loc.t1("%@ zamanını oynatma konumuna ayarla", root.title);
        clicked => { MainBridge.set-now(root.edge); }
    }
}

component EditActions inherits HorizontalLayout {
    in property <bool> icon-only;
    spacing: 8px;
    PushButton {
        small: true;
        symbol: "scissors";
        label: root.icon-only ? "" : Loc.t("Böl");
        accessible-name: Loc.t("Böl");
        enabled: MainBridge.can-split;
        tooltip: Loc.t("Satırı oynatma konumundan ikiye böl");
        clicked => { MainBridge.split(); }
    }
    PushButton {
        small: true;
        symbol: "arrow.triangle.2.circlepath";
        label: root.icon-only ? "" : Loc.t("Seçilenleri yeniden çevir");
        accessible-name: Loc.t("Seçilenleri yeniden çevir");
        enabled: MainBridge.can-retranslate;
        tooltip: Loc.t("⌘ veya ⇧ ile satırları seç, seçilenleri yeniden çevir");
        clicked => { MainBridge.retranslate(); }
    }
    PushButton {
        small: true;
        symbol: "arrow.triangle.merge";
        label: root.icon-only ? "" : Loc.t("Sonrakiyle birleştir");
        accessible-name: Loc.t("Sonrakiyle birleştir");
        enabled: MainBridge.can-merge;
        tooltip: Loc.t("Sonrakiyle birleştir");
        clicked => { MainBridge.merge(); }
    }
    PushButton {
        small: true;
        symbol: "trash";
        label: root.icon-only ? "" : Loc.t("Sil");
        accessible-name: Loc.t("Sil");
        enabled: MainBridge.can-delete;
        tooltip: Loc.t("Satırı Sil (⌫)");
        clicked => { MainBridge.delete-lines(); }
    }
}

component Badge inherits Rectangle {
    border-radius: self.height / 2;
    background: MacTheme.control-accent.with-alpha(0.14);
    height: 18px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Spinner { width: 10px; height: 10px; y: 4px; indeterminate: true; }
        Text {
            text: MainBridge.badge-text;
            font-size: MacTheme.caption-size;
            font-weight: 600;
            vertical-alignment: center;
            color: MacTheme.control-accent;
        }
    }
}

component EmptyState inherits VerticalLayout {
    in property <string> symbol;
    in property <string> title;
    in property <string> detail;
    alignment: center;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        Sym { name: root.symbol; size: 40px; tint: MacTheme.secondary-label; }
    }
    Text {
        text: root.title;
        font-size: MacTheme.title2-size;
        font-weight: 600;
        horizontal-alignment: center;
        color: MacTheme.label;
    }
    if root.detail != "": Text {
        text: root.detail;
        font-size: MacTheme.callout-size;
        horizontal-alignment: center;
        wrap: word-wrap;
        color: MacTheme.secondary-label;
    }
}

export component SentenceEditor inherits Rectangle {
    property <bool> captions: root.width >= 540px;
    property <bool> icon-only: root.width < 900px;
    property <length> timing-a: (root.captions ? 60px : 0) + 19px + 52px + 19px + 22px + 16px;
    property <length> timing-b: (root.captions ? 60px : 0) + 19px + 52px + 19px + 12px;
    property <length> actions-w: root.icon-only ? 4 * 24px + 24px : 440px;
    property <length> badge-w: MainBridge.badge-text != "" ? 130px : 0;
    // 0 = one row with "Şimdiki an", 1 = one row without, 2 = two rows.
    property <int> bar-layout: root.width - 24px >= 2 * root.timing-a + 32px + root.badge-w + root.actions-w ? 0
        : root.width - 24px >= 2 * root.timing-b + 16px + root.badge-w + root.actions-w ? 1 : 2;
    property <length> menu-x;
    property <length> menu-y;

    if MainBridge.has-sentences: VerticalLayout {
        // Edit bar (small controls, padding h12 v6; disabled while working).
        Rectangle {
            opacity: MainBridge.is-working ? 0.5 : 1;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;
                if root.bar-layout < 2: HorizontalLayout {
                    spacing: root.bar-layout == 0 ? 16px : 8px;
                    Timing { title: Loc.t("Başlangıç"); value: MainBridge.selected-start-text; edge: 0; caption: root.captions; scope: root.bar-layout == 0; }
                    Timing { title: Loc.t("Bitiş"); value: MainBridge.selected-end-text; edge: 1; caption: root.captions; scope: root.bar-layout == 0; }
                    Rectangle { horizontal-stretch: 1; }
                    if MainBridge.badge-text != "": Badge { }
                    EditActions { icon-only: root.icon-only; }
                }
                if root.bar-layout == 2: HorizontalLayout {
                    spacing: 6px;
                    Timing { title: Loc.t("Başlangıç"); value: MainBridge.selected-start-text; edge: 0; caption: false; scope: false; }
                    Timing { title: Loc.t("Bitiş"); value: MainBridge.selected-end-text; edge: 1; caption: false; scope: false; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.bar-layout == 2: HorizontalLayout {
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; }
                    if MainBridge.badge-text != "": Badge { }
                    EditActions { icon-only: root.icon-only; }
                }
            }
            TouchArea { enabled: MainBridge.is-working; }
        }
        Rectangle { height: 1px; background: MacTheme.separator; }
        keys := FocusScope {
            vertical-stretch: 1;
            changed has-focus => { MainBridge.list-focus-changed(self.has-focus); }
            key-pressed(e) => {
                if (e.text == Key.UpArrow) { return MainBridge.list-key("up", e.modifiers.shift) ? accept : reject; }
                if (e.text == Key.DownArrow) { return MainBridge.list-key("down", e.modifiers.shift) ? accept : reject; }
                if (e.text == Key.Backspace || e.text == Key.Delete) { return MainBridge.list-key("delete", e.modifiers.shift) ? accept : reject; }
                reject
            }
            list := ListView {
                accessible-label: Loc.t("Satırlar");
                for row[i] in MainBridge.rows: VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    TableRow {
                        index: i;
                        item: row;
                        shows-speakers: MainBridge.shows-speakers;
                        list-focused: keys.has-focus;
                        grab-focus => { keys.focus(); }
                        context(mx, my) => {
                            root.menu-x = self.absolute-position.x - root.absolute-position.x + mx;
                            root.menu-y = self.absolute-position.y - root.absolute-position.y + my;
                            rowmenu.show();
                        }
                    }
                }
            }
            property <int> epoch: MainBridge.scroll-epoch;
            changed epoch => {
                if (MainBridge.scroll-row >= 0) {
                    list.content-y = min(0px, max(list.visible-height - list.content-height, list.visible-height / 2 - (MainBridge.scroll-row + 0.5) * 44px));
                }
            }
        }
    }
    if !MainBridge.has-sentences: EmptyState {
        symbol: MainBridge.empty-symbol;
        title: MainBridge.empty-title;
        detail: MainBridge.empty-detail;
    }
    rowmenu := MacMenu {
        x: root.menu-x;
        y: root.menu-y;
        min-menu-width: 230px;
    }
}
