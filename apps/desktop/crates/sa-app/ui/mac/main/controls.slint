// AppKit-looking controls the SwiftUI app uses and std-widgets lack (mac-ui §1, §14): SF Symbol images, borderless
// toolbar buttons, bordered push buttons (regular / small), pop-up buttons with per-item disabled entries, pull-down
// menus (NSMenu look, check marks, one submenu), segmented controls (window and on-video variants), 1 s tooltips.
import { Spinner } from "std-widgets.slint";
import { Loc } from "../../shared/loc.slint";
import { MainBridge, Symbols } from "../../shared/bridge.slint";
import { MenuEntry, PickerItem } from "../../shared/main_types.slint";
import { MacTheme } from "../theme.slint";

export component Sym inherits Image {
    in property <string> name;
    in property <length> size: 16px;
    in property <brush> tint: MacTheme.label;
    // The symbol's natural bounds at this point size, like `Image(systemName:)` with `.font(.system(size:))`.
    width: Symbols.image-width(root.name, root.size);
    height: Symbols.image-height(root.name, root.size);
    source: Symbols.image(root.name, root.size);
    colorize: root.tint;
    image-fit: contain;
    accessible-role: none;
}

// `.help` tooltip: ~1 s hover delay, small rounded box.
export component ToolTip {
    in property <string> text;
    in property <bool> show;
    in property <length> offset-y: 26px;
    property <bool> shown;
    width: 0;
    height: 0;
    Timer {
        interval: 1000ms;
        running: root.show && !root.shown && root.text != "";
        triggered => {
            root.shown = true;
            popup.show();
        }
    }
    changed show => {
        if (!root.show) {
            root.shown = false;
            popup.close();
        }
    }
    popup := PopupWindow {
        close-policy: no-auto-close;
        y: root.offset-y;
        Rectangle {
            background: MacTheme.tooltip-background;
            border-radius: 4px;
            border-width: 0.5px;
            border-color: MacTheme.menu-border;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000033;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                Text {
                    text: root.text;
                    font-size: 11px;
                    color: MacTheme.label;
                    wrap: word-wrap;
                    max-width: 300px;
                }
            }
        }
    }
}

// Borderless toolbar button: hover shows a rounded 6 pt gray background; disabled = 50 % opacity; prominent =
// accent filled with white text; toggled = accent-tinted icon on the hover fill.
export component ToolbarButton inherits Rectangle {
    in property <string> symbol;
    in property <string> label;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> prominent;
    in property <bool> toggled;
    in property <bool> menu-indicator;
    callback clicked();
    height: 28px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.prominent ? (touch.pressed ? MacTheme.control-accent.darker(0.15) : MacTheme.control-accent)
        : (touch.pressed ? MacTheme.hover-fill.darker(0.4) : (touch.has-hover || root.toggled ? MacTheme.hover-fill : transparent));
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : (root.label != "" ? root.label : root.tooltip);
    accessible-enabled: root.enabled;
    accessible-checkable: root.toggled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if root.symbol != "": Sym {
            y: (parent.height - self.height) / 2;
            name: root.symbol;
            size: 16px;
            tint: root.prominent ? white : (root.toggled ? MacTheme.control-accent : MacTheme.label);
        }
        if root.label != "": Text {
            text: root.label;
            font-size: MacTheme.body-size;
            vertical-alignment: center;
            color: root.prominent ? white : MacTheme.label;
        }
        @children
        if root.menu-indicator: Sym {
            y: (parent.height - self.height) / 2;
            name: "chevron.down";
            size: 8px;
            tint: MacTheme.secondary-label;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
        offset-y: 32px;
    }
}

// Bordered push button (regular 22 pt, small 19 pt).
export component PushButton inherits Rectangle {
    in property <string> symbol;
    in property <string> label;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <bool> prominent;
    in property <bool> destructive;
    callback clicked();
    height: root.small ? 19px : 22px;
    min-width: root.small ? 22px : 28px;
    border-radius: root.small ? 4.5px : 5.5px;
    border-width: root.prominent ? 0 : 0.5px;
    border-color: MacTheme.button-border;
    background: root.prominent ? (touch.pressed ? MacTheme.control-accent.darker(0.15) : MacTheme.control-accent) : (touch.pressed ? MacTheme.button-pressed : MacTheme.button-background);
    drop-shadow-blur: root.prominent || MacTheme.dark ? 0 : 1px;
    drop-shadow-offset-y: 0.5px;
    drop-shadow-color: #0000001f;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : (root.label != "" ? root.label : root.tooltip);
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    property <brush> fg: root.prominent ? white : root.destructive ? MacTheme.system-red : MacTheme.label;
    HorizontalLayout {
        padding-left: root.small ? 6px : 8px;
        padding-right: root.small ? 6px : 8px;
        spacing: 4px;
        alignment: center;
        if root.symbol != "": Sym {
            y: (parent.height - self.height) / 2;
            name: root.symbol;
            size: root.small ? 11px : 13px;
            tint: root.fg;
        }
        if root.label != "": Text {
            text: root.label;
            font-size: root.small ? MacTheme.small-size : MacTheme.body-size;
            vertical-alignment: center;
            color: root.fg;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// NSMenu-looking popup over `MainBridge.menu-entries` (level 0) with one cascading submenu (level 1).
component MenuItemRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> hidden;
    in property <bool> check-column: true;
    callback activated();
    callback submenu-requested();
    height: root.hidden ? 0 : root.entry.separator ? 11px : 22px;
    visible: !root.hidden;
    border-radius: 4px;
    property <bool> hot: touch.has-hover && root.entry.enabled && !root.entry.separator;
    background: root.hot ? MacTheme.control-accent : transparent;
    property <brush> fg: root.hot ? white : !root.entry.enabled ? MacTheme.tertiary-label : root.entry.destructive ? MacTheme.system-red : MacTheme.label;
    accessible-role: button;
    accessible-label: root.entry.title;
    accessible-checkable: root.entry.checkable;
    accessible-checked: root.entry.checked;
    accessible-enabled: root.entry.enabled;
    if root.entry.separator: Rectangle {
        x: 10px;
        width: parent.width - 20px;
        y: 5px;
        height: 1px;
        background: MacTheme.separator;
    }
    if !root.entry.separator: HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 4px;
        Rectangle {
            width: root.check-column ? 14px : 0;
            if root.entry.checked: Sym {
                name: "checkmark";
                size: 10px;
                tint: root.fg;
            }
        }
        if root.entry.symbol != "": Sym {
            y: (parent.height - self.height) / 2;
            name: root.entry.symbol;
            size: 13px;
            tint: root.entry.tint.alpha > 0 && !root.hot ? root.entry.tint : root.fg;
        }
        Text {
            text: root.entry.title;
            font-size: MacTheme.body-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.fg;
        }
        if root.entry.submenu: Sym {
            y: (parent.height - self.height) / 2;
            name: "chevron.right";
            size: 9px;
            tint: root.fg;
        }
    }
    touch := TouchArea {
        enabled: root.entry.enabled && !root.entry.separator;
        clicked => {
            if (root.entry.submenu) { root.submenu-requested(); } else { root.activated(); }
        }
        changed has-hover => {
            if (self.has-hover && root.entry.submenu) { root.submenu-requested(); }
        }
    }
}

export component MacMenu inherits PopupWindow {
    in property <length> min-menu-width: 180px;
    property <[MenuEntry]> entries: MainBridge.menu-entries;
    property <length> sub-y;
    Rectangle {
        min-width: root.min-menu-width;
        background: MacTheme.menu-background;
        border-radius: 6px;
        border-width: 0.5px;
        border-color: MacTheme.menu-border;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 5px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            padding: 5px;
            for e in root.entries: MenuItemRow {
                entry: e;
                hidden: e.level != 0;
                activated => {
                    MainBridge.menu-activated(e.id);
                    root.close();
                }
                submenu-requested => {
                    root.sub-y = self.y;
                    sub.show();
                }
            }
        }
    }
    sub := PopupWindow {
        x: root.min-menu-width - 4px;
        y: root.sub-y;
        Rectangle {
            min-width: 120px;
            background: MacTheme.menu-background;
            border-radius: 6px;
            border-width: 0.5px;
            border-color: MacTheme.menu-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 5px;
                for e in root.entries: MenuItemRow {
                    entry: e;
                    hidden: e.level != 1;
                    activated => {
                        MainBridge.menu-activated(e.id);
                        sub.close();
                        root.close();
                    }
                }
            }
        }
    }
}

// Pull-down menu button (toolbar `Menu`, borderless) that asks Rust for its entries.
export component MenuButton inherits Rectangle {
    in property <string> menu-id;
    in property <string> symbol;
    in property <string> label;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> indicator: true;
    in property <bool> bordered;
    in property <length> menu-width: 220px;
    in property <brush> fg: MacTheme.label;
    in property <length> label-min-width;
    callback opened();
    height: root.bordered ? 22px : 28px;
    border-radius: root.bordered ? 5.5px : 6px;
    border-width: root.bordered ? 0.5px : 0;
    border-color: MacTheme.button-border;
    opacity: root.enabled ? 1 : 0.5;
    background: root.bordered ? MacTheme.button-background : (touch.pressed ? MacTheme.hover-fill.darker(0.4) : touch.has-hover ? MacTheme.hover-fill : transparent);
    accessible-role: combobox;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.label;
    accessible-value: root.label;
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 5px;
        if root.symbol != "": Sym {
            y: (parent.height - self.height) / 2;
            name: root.symbol;
            size: 16px;
            tint: root.fg;
        }
        @children
        if root.label != "": Text {
            text: root.label;
            min-width: root.label-min-width;
            font-size: MacTheme.body-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.fg;
        }
        if root.indicator: Sym {
            y: (parent.height - self.height) / 2;
            name: "chevron.down";
            size: 8px;
            tint: MacTheme.secondary-label;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.opened();
            MainBridge.menu-requested(root.menu-id);
            menu.show();
        }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
        offset-y: root.height + 4px;
    }
    menu := MacMenu {
        x: 0;
        y: root.height + 2px;
        min-menu-width: max(root.width, root.menu-width);
    }
}

// NSPopUpButton (regular bordered) with per-item disabled entries; the menu opens over the button.
export component PopUpButton inherits Rectangle {
    in property <[PickerItem]> items;
    in property <int> current-index;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> small;
    callback selected(int);
    height: root.small ? 19px : 22px;
    border-radius: 5.5px;
    border-width: 0.5px;
    border-color: MacTheme.button-border;
    background: touch.pressed ? MacTheme.button-pressed : MacTheme.button-background;
    drop-shadow-blur: MacTheme.dark ? 0 : 1px;
    drop-shadow-offset-y: 0.5px;
    drop-shadow-color: #0000001f;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.items.length ? root.items[root.current-index].title : "";
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 3px;
        spacing: 4px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.items.length ? root.items[root.current-index].title : "";
            font-size: root.small ? MacTheme.small-size : MacTheme.body-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: MacTheme.label;
        }
        // Up/down chevrons on an accent square (macOS 15 pop-up indicator).
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: MacTheme.control-accent;
            VerticalLayout {
                alignment: center;
                spacing: -1px;
                Sym { name: "chevron.up"; size: 7px; tint: white; x: 4.5px; }
                Sym { name: "chevron.down"; size: 7px; tint: white; x: 4.5px; }
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
    popup := PopupWindow {
        x: -16px;
        y: - max(0, root.current-index) * 22px - 5px;
        Rectangle {
            min-width: root.width + 24px;
            background: MacTheme.menu-background;
            border-radius: 6px;
            border-width: 0.5px;
            border-color: MacTheme.menu-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 5px;
                for item[i] in root.items: prow := Rectangle {
                    height: 22px;
                    border-radius: 4px;
                    property <bool> hot: rowtouch.has-hover && item.enabled;
                    background: self.hot ? MacTheme.control-accent : transparent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 12px;
                        spacing: 4px;
                        Rectangle {
                            width: 14px;
                            if i == root.current-index: Sym {
                                name: "checkmark";
                                size: 10px;
                                tint: prow.hot ? white : MacTheme.label;
                            }
                        }
                        Text {
                            text: item.title;
                            font-size: MacTheme.body-size;
                            vertical-alignment: center;
                            overflow: elide;
                            color: prow.hot ? white : item.enabled ? MacTheme.label : MacTheme.tertiary-label;
                        }
                    }
                    rowtouch := TouchArea {
                        enabled: item.enabled;
                        clicked => {
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Segmented control. `on-dark`: drawn for the black player (white text, translucent white selection).
export component Segmented inherits Rectangle {
    in property <[PickerItem]> items;
    in property <int> current-index;
    in property <bool> on-dark;
    in property <string> accessible-name;
    in property <length> fixed-width: 0;
    callback selected(int);
    height: 22px;
    width: root.fixed-width > 0 ? root.fixed-width : lay.preferred-width;
    border-radius: 6px;
    background: root.on-dark ? #ffffff1f : MacTheme.quaternary-fill;
    accessible-role: tab-list;
    accessible-label: root.accessible-name;
    lay := HorizontalLayout {
        padding: 1px;
        spacing: 1px;
        for item[i] in root.items: seg := Rectangle {
            horizontal-stretch: 1;
            border-radius: 5px;
            property <bool> sel: i == root.current-index;
            background: self.sel ? (root.on-dark ? #ffffff40 : (MacTheme.dark ? #636366 : #ffffff)) : transparent;
            drop-shadow-blur: self.sel && !root.on-dark ? 1px : 0;
            drop-shadow-color: #0000003a;
            drop-shadow-offset-y: self.sel ? 0.5px : 0;
            opacity: item.enabled ? 1 : 0.4;
            accessible-role: tab;
            accessible-label: item.title;
            accessible-item-selected: self.sel;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: item.title;
                    font-size: MacTheme.body-size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                    color: root.on-dark ? white : MacTheme.label;
                }
            }
            TouchArea {
                enabled: item.enabled;
                clicked => { root.selected(i); }
            }
        }
    }
}

// Small indeterminate spinner (`ProgressView().controlSize(.small)`).
export component SmallSpinner inherits Spinner {
    width: 16px;
    height: 16px;
    indeterminate: true;
}
