// SwiftUI `.formStyle(.grouped)` look for the Settings tabs (mac-ui §11): a section = header (13 pt semibold) above
// a rounded (radius 10) inset box with 1 pt separators between rows, footer (11 pt secondary) below. Rows: label
// leading, control trailing. Plus the pop-up button with separators, switches and a slider row.
import { Switch, Slider, LineEdit } from "std-widgets.slint";
import { MacTheme } from "../theme.slint";
import { Sym, ToolTip } from "../main/controls.slint";

export component FormSection inherits VerticalLayout {
    in property <string> header;
    in property <string> footer;
    spacing: 0px;
    if root.header != "": VerticalLayout {
        padding-left: 10px;
        padding-bottom: 6px;
        Text {
            text: root.header;
            font-size: 13px;
            font-weight: 600;
            color: MacTheme.label;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
    }
    Rectangle {
        border-radius: 10px;
        background: MacTheme.dark ? #ffffff0a : #ffffff;
        border-width: 1px;
        border-color: MacTheme.dark ? #ffffff10 : #0000000d;
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            @children
        }
    }
    if root.footer != "": VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        Text {
            text: root.footer;
            font-size: 11px;
            color: MacTheme.secondary-label;
            wrap: word-wrap;
        }
    }
}

// The 1 pt separator between rows of a section.
export component RowSeparator inherits Rectangle {
    height: 1px;
    background: MacTheme.separator;
}

// A labeled row: label leading, `@children` trailing (pop-up, switch, slider…). `min-height` ≈ 22 pt control + 2×7.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> first;
    padding-top: 7px;
    padding-bottom: 7px;
    spacing: 12px;
    min-height: 36px;
    Text {
        text: root.label;
        font-size: MacTheme.body-size;
        color: root.enabled ? MacTheme.label : MacTheme.tertiary-label;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}

// A caption (caption font, secondary) row text.
export component Caption inherits Text {
    font-size: 11px;
    color: MacTheme.secondary-label;
    wrap: word-wrap;
}

// NSPopUpButton over plain titles with an optional separator before `separator-index` (and before index 1 when
// `separator-after-first`, the `"Sistem"` + families menus).
export component MacPopUp inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    in property <int> separator-index: -1;
    in property <bool> separator-after-first;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <length> menu-max-height: 420px;
    callback selected(int);
    property <string> title: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    height: 22px;
    min-width: 80px;
    preferred-width: min(240px, max(100px, probe.preferred-width + 40px));
    border-radius: 5.5px;
    border-width: 0.5px;
    border-color: MacTheme.button-border;
    background: touch.pressed ? MacTheme.button-pressed : MacTheme.button-background;
    drop-shadow-blur: MacTheme.dark ? 0 : 1px;
    drop-shadow-offset-y: 0.5px;
    drop-shadow-color: #0000001f;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.title;
    accessible-enabled: root.enabled;
    probe := Text {
        visible: false;
        text: root.title;
        font-size: MacTheme.body-size;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 3px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: MacTheme.body-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: MacTheme.label;
        }
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: MacTheme.control-accent;
            VerticalLayout {
                alignment: center;
                spacing: -1px;
                Sym { name: "chevron.up"; size: 7px; tint: white; x: 4.5px; }
                Sym { name: "chevron.down"; size: 7px; tint: white; x: 4.5px; }
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
    popup := PopupWindow {
        x: -16px;
        y: -5px - min(max(0, root.current-index) * 22px, root.menu-max-height / 2);
        Rectangle {
            min-width: root.width + 24px;
            background: MacTheme.menu-background;
            border-radius: 6px;
            border-width: 0.5px;
            border-color: MacTheme.menu-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #00000040;
            clip: true;
            Flickable {
                height: min(list.preferred-height, root.menu-max-height);
                content-height: list.preferred-height;
                list := VerticalLayout {
                    padding: 5px;
                    for item[i] in root.model: VerticalLayout {
                        if (i == root.separator-index && i > 0) || (root.separator-after-first && i == 1): Rectangle {
                            height: 11px;
                            Rectangle {
                                x: 10px;
                                width: parent.width - 20px;
                                height: 1px;
                                background: MacTheme.separator;
                            }
                        }
                        prow := Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            property <bool> hot: rowtouch.has-hover;
                            background: self.hot ? MacTheme.control-accent : transparent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 12px;
                                spacing: 4px;
                                Rectangle {
                                    width: 14px;
                                    if i == root.current-index: Sym {
                                        name: "checkmark";
                                        size: 10px;
                                        tint: prow.hot ? white : MacTheme.label;
                                    }
                                }
                                Text {
                                    text: item;
                                    font-size: MacTheme.body-size;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: prow.hot ? white : MacTheme.label;
                                }
                            }
                            rowtouch := TouchArea {
                                clicked => {
                                    root.selected(i);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A small NSSwitch (SwiftUI Toggle in a grouped Form).
export component MacSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? MacTheme.control-accent : (MacTheme.dark ? #ffffff26 : #00000017);
    border-width: root.checked ? 0px : 0.5px;
    border-color: MacTheme.dark ? #ffffff1a : #0000001f;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(root.checked); } }
    animate background { duration: 150ms; }
    knob := Rectangle {
        width: 20px;
        height: 20px;
        y: 1px;
        x: root.checked ? root.width - self.width - 1px : 1px;
        border-radius: 10px;
        background: white;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// The round mark that shows which provider row is the active one (`checkmark.circle.fill` / `circle`).
export component SelectionMark inherits Rectangle {
    in property <bool> selected;
    width: 20px;
    height: 20px;
    accessible-role: none;
    Sym {
        name: root.selected ? "checkmark.circle.fill" : "circle";
        size: 17px;
        tint: root.selected ? MacTheme.control-accent : MacTheme.secondary-label;
    }
}

// A rounded-border text field (`.textFieldStyle(.roundedBorder)`).
export component MacField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback edited(string);
    callback accepted(string);
    callback focus-lost(string);
    height: 22px;
    min-width: 80px;
    border-radius: 5px;
    border-width: input.has-focus ? 2px : 0.5px;
    border-color: input.has-focus ? MacTheme.control-accent.with-alpha(0.6) : MacTheme.button-border;
    background: MacTheme.dark ? #ffffff0d : #ffffff;
    opacity: root.enabled ? 1 : 0.5;
    clip: true;
    if root.text == "" && !input.has-focus: Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.placeholder;
        font-size: MacTheme.body-size;
        color: MacTheme.tertiary-label;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        text <=> root.text;
        enabled: root.enabled;
        font-size: MacTheme.body-size;
        color: MacTheme.label;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: MacTheme.control-accent.with-alpha(0.35);
        accessible-label: root.accessible-name;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        changed has-focus => {
            if (!self.has-focus) {
                root.focus-lost(self.text);
            }
        }
    }
}

// A labeled text field row of the editor sheet (`TextField(label, text:, prompt:)` in a grouped form).
export component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    callback edited(string);
    padding-top: 7px;
    padding-bottom: 7px;
    spacing: 12px;
    Text {
        text: root.label;
        font-size: MacTheme.body-size;
        color: MacTheme.label;
        vertical-alignment: center;
        min-width: 110px;
    }
    MacField {
        horizontal-stretch: 1;
        text <=> root.text;
        placeholder: root.placeholder;
        password: root.password;
        accessible-name: root.label;
        edited(t) => { root.edited(t); }
    }
}
