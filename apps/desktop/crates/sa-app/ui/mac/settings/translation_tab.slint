// Settings ▸ Çeviri (mac-ui §11.2, `TranslationSettingsTab`): the local row with the default translation model, one
// row per saved provider (activate, Test et / Düzenle / Sil, model field + "Modelleri seç" menu, test notice),
// "API sağlayıcısı ekle…" and the cloud callout.
import { Loc } from "../../shared/loc.slint";
import { SettingsBridge, SettingsProviderRow } from "../../shared/bridge.slint";
import { MacTheme } from "../theme.slint";
import { Sym, PushButton, SmallSpinner, ToolTip } from "../main/controls.slint";
import { FormSection, RowSeparator, Caption, MacPopUp, MacField, SelectionMark } from "form.slint";

// Borderless icon-only menu `"Modelleri seç"` (`list.bullet`): the known models, separator, "Uzaktaki modelleri
// listele".
component ModelsMenu inherits Rectangle {
    in property <[string]> models;
    in property <bool> refresh-enabled: true;
    callback chosen(string);
    callback refresh();
    width: 26px;
    height: 22px;
    border-radius: 5px;
    background: touch.pressed ? MacTheme.hover-fill : transparent;
    accessible-role: button;
    accessible-label: Loc.t("Modelleri seç");
    HorizontalLayout {
        alignment: center;
        spacing: 1px;
        Sym { name: "list.bullet"; size: 13px; tint: MacTheme.secondary-label; y: (parent.height - self.height) / 2; }
        Sym { name: "chevron.down"; size: 7px; tint: MacTheme.secondary-label; y: (parent.height - self.height) / 2; }
    }
    touch := TouchArea { clicked => { menu.show(); } }
    ToolTip {
        text: Loc.t("Modelleri seç");
        show: touch.has-hover && !touch.pressed;
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        Rectangle {
            min-width: 220px;
            background: MacTheme.menu-background;
            border-radius: 6px;
            border-width: 0.5px;
            border-color: MacTheme.menu-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 5px;
                for m in root.models: mrow := Rectangle {
                    height: 22px;
                    border-radius: 4px;
                    background: mt.has-hover ? MacTheme.control-accent : transparent;
                    Text {
                        x: 20px;
                        width: parent.width - 32px;
                        text: m;
                        font-size: MacTheme.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                        color: mt.has-hover ? white : MacTheme.label;
                    }
                    mt := TouchArea {
                        clicked => {
                            root.chosen(m);
                            menu.close();
                        }
                    }
                }
                if root.models.length > 0: Rectangle {
                    height: 11px;
                    Rectangle { x: 10px; width: parent.width - 20px; height: 1px; background: MacTheme.separator; }
                }
                Rectangle {
                    height: 22px;
                    border-radius: 4px;
                    background: rt.has-hover && root.refresh-enabled ? MacTheme.control-accent : transparent;
                    Text {
                        x: 20px;
                        text: Loc.t("Uzaktaki modelleri listele");
                        font-size: MacTheme.body-size;
                        vertical-alignment: center;
                        color: !root.refresh-enabled ? MacTheme.tertiary-label : rt.has-hover ? white : MacTheme.label;
                    }
                    rt := TouchArea {
                        enabled: root.refresh-enabled;
                        clicked => {
                            root.refresh();
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

export { ModelsMenu }

component NoticeLabel inherits HorizontalLayout {
    in property <string> text;
    in property <bool> error;
    spacing: 4px;
    Sym {
        name: root.error ? "exclamationmark.triangle.fill" : "checkmark.circle.fill";
        size: 11px;
        tint: root.error ? MacTheme.system-red : MacTheme.system-green;
        y: 2px;
    }
    Text {
        text: root.text;
        font-size: 11px;
        color: root.error ? MacTheme.system-red : MacTheme.system-green;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export { NoticeLabel }

component ProviderRowView inherits VerticalLayout {
    in property <SettingsProviderRow> item;
    in-out property <string> model-text: root.item.model;
    spacing: 6px;
    padding-top: 4px + 7px;
    padding-bottom: 4px + 7px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            accessible-role: button;
            accessible-label: root.item.name;
            accessible-item-selected: root.item.is-active;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: start;
                    SelectionMark { selected: root.item.is-active; }
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.item.name;
                            font-size: MacTheme.body-size;
                            font-weight: 500;
                            color: MacTheme.label;
                            vertical-alignment: center;
                        }
                        if root.item.shows-preset-tag: Rectangle {
                            border-radius: self.height / 2;
                            background: MacTheme.quaternary-fill;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 1px;
                                padding-bottom: 1px;
                                Text {
                                    text: root.item.preset-name;
                                    font-size: 10px;
                                    color: MacTheme.label;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: root.item.summary;
                        font-size: 11px;
                        color: MacTheme.secondary-label;
                        overflow: elide;
                    }
                }
            }
            TouchArea { clicked => { SettingsBridge.provider-activate(root.item.id); } }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                if root.item.is-testing: SmallSpinner { width: 16px; height: 16px; }
                PushButton {
                    small: true;
                    label: Loc.t("Test et");
                    tooltip: Loc.t("Sunucuya ping at ve modelleri getir");
                    enabled: !root.item.is-testing;
                    clicked => { SettingsBridge.provider-test(root.item.id); }
                }
                PushButton {
                    small: true;
                    label: Loc.t("Düzenle");
                    clicked => { SettingsBridge.provider-edit(root.item.id); }
                }
                PushButton {
                    small: true;
                    label: Loc.t("Sil");
                    clicked => { SettingsBridge.provider-delete(root.item.id); }
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 28px;
        spacing: 6px;
        Caption {
            text: Loc.t("Model:");
            vertical-alignment: center;
            wrap: no-wrap;
        }
        MacField {
            horizontal-stretch: 1;
            text <=> root.model-text;
            placeholder: Loc.t("Model seçin veya yazın");
            accessible-name: Loc.t("Model");
            accepted(t) => { SettingsBridge.provider-model-committed(root.item.id, t); }
            focus-lost(t) => { SettingsBridge.provider-model-committed(root.item.id, t); }
        }
        ModelsMenu {
            models: root.item.models;
            refresh-enabled: !root.item.is-testing;
            chosen(m) => {
                root.model-text = m;
                SettingsBridge.provider-model-committed(root.item.id, m);
            }
            refresh => { SettingsBridge.provider-refresh-models(root.item.id); }
        }
    }
    if root.item.notice-text != "": HorizontalLayout {
        padding-left: 28px;
        NoticeLabel {
            text: root.item.notice-text;
            error: root.item.notice-error;
        }
    }
}

export component TranslationTab inherits VerticalLayout {
    spacing: 20px;

    FormSection {
        header: Loc.t("Çeviri sağlayıcıları ve API anahtarları");
        footer: Loc.t("Bulut sağlayıcıları etkinken çevrilecek metin internet üzerinden o sağlayıcıya gönderilir; ses ve video hiçbir durumda gönderilmez. Yerel modellerde ve yerel ağdaki sunucularda metin internete çıkmaz. Çevrimdışı mod açıkken bulut sağlayıcıları kullanılmaz.");

        // Local row.
        VerticalLayout {
            spacing: 6px;
            padding-top: 4px + 7px;
            padding-bottom: 4px + 7px;
            Rectangle {
                accessible-role: button;
                accessible-label: Loc.t("Yerel modeller (Cihaz üzerinde)");
                accessible-item-selected: SettingsBridge.local-provider-active;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        SelectionMark { selected: SettingsBridge.local-provider-active; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: Loc.t("Yerel modeller (Cihaz üzerinde)");
                            font-size: MacTheme.body-size;
                            font-weight: 500;
                            color: MacTheme.label;
                        }
                        Caption { text: Loc.t("Çeviri tamamen bu bilgisayarda indirilen yerel modellerle yapılır."); }
                    }
                }
                TouchArea { clicked => { SettingsBridge.provider-activate(""); } }
            }
            HorizontalLayout {
                padding-left: 28px;
                spacing: 12px;
                Text {
                    text: Loc.t("Varsayılan çeviri modeli");
                    font-size: MacTheme.body-size;
                    color: SettingsBridge.translation-model-enabled ? MacTheme.label : MacTheme.tertiary-label;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                MacPopUp {
                    model: SettingsBridge.translation-model-items;
                    current-index: SettingsBridge.translation-model-index;
                    separator-index: SettingsBridge.translation-model-separator;
                    enabled: SettingsBridge.translation-model-enabled;
                    accessible-name: Loc.t("Varsayılan çeviri modeli");
                    selected(i) => { SettingsBridge.translation-model-selected(i); }
                }
            }
            HorizontalLayout {
                padding-left: 28px;
                Caption { text: Loc.t("“Çevir…” düğmesi bu modeli kullanır; seçim sonraki açılışlarda da korunur."); }
            }
        }

        for row in SettingsBridge.provider-rows: VerticalLayout {
            RowSeparator { }
            ProviderRowView { item: row; }
        }

        RowSeparator { }
        HorizontalLayout {
            padding-top: 7px;
            padding-bottom: 7px;
            alignment: start;
            PushButton {
                symbol: "plus";
                label: Loc.t("API sağlayıcısı ekle…");
                clicked => { SettingsBridge.provider-add(); }
            }
        }
        if SettingsBridge.cloud-callout != "": VerticalLayout {
            RowSeparator { }
            HorizontalLayout {
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 6px;
                Sym { name: "cloud"; size: 14px; tint: MacTheme.system-orange; y: 1px; }
                Text {
                    text: SettingsBridge.cloud-callout;
                    font-size: 12px;
                    color: MacTheme.label;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
