// Fluent tokens of the WinUI app (win-ui-main §5). Light/dark follow `Palette.color-scheme`, which Rust sets from
// `appTheme` (System = follow the OS). The `fluent` std-widgets style provides the controls; these tokens cover custom chrome.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces (Mica shows through the window background when available).
    out property <brush> window-background: dark ? #202020 : #f3f3f3;
    // LayerFillColorDefault
    out property <brush> layer-fill: dark ? #3a3a3a4c : #ffffff80;
    // CardBackgroundFillColorDefault / CardStrokeColorDefault
    out property <brush> card-background: dark ? #ffffff0d : #ffffffb3;
    out property <brush> card-stroke: dark ? #00000019 : #0000000f;
    // DividerStrokeColorDefault
    out property <brush> divider: dark ? #ffffff15 : #0000000f;
    // ControlStrongStrokeColorDefault / ControlStrongFillColorDisabled
    out property <brush> control-strong-stroke: dark ? #ffffff8b : #00000072;
    out property <brush> control-strong-fill-disabled: dark ? #ffffff3f : #00000051;
    // ControlFillColorDefault (button background), hover/pressed fills of default buttons
    out property <brush> control-fill: dark ? #ffffff0f : #ffffffb3;
    out property <brush> control-fill-hover: dark ? #ffffff15 : #f9f9f980;
    out property <brush> control-fill-pressed: dark ? #ffffff08 : #f9f9f94d;
    out property <brush> control-stroke: dark ? #ffffff12 : #0000000f;
    out property <brush> control-stroke-bottom: dark ? #ffffff18 : #00000029;
    // SubtleFillColorSecondary / Tertiary (hover / pressed of subtle buttons)
    out property <brush> subtle-hover: dark ? #ffffff0f : #00000009;
    out property <brush> subtle-pressed: dark ? #ffffff0a : #00000006;
    // Flyout / menu surface (AcrylicInAppFillColorDefault fallback) and its stroke
    out property <brush> flyout-background: dark ? #2c2c2c : #f9f9f9;
    out property <brush> flyout-stroke: dark ? #00000033 : #0000000f;
    // Tooltip
    out property <brush> tooltip-background: dark ? #2c2c2c : #f9f9f9;

    // Text
    out property <brush> text-primary: dark ? #ffffff : #000000e4;
    out property <brush> text-secondary: dark ? #ffffffc5 : #0000009e;
    out property <brush> text-tertiary: dark ? #ffffff87 : #00000072;
    out property <brush> text-disabled: dark ? #ffffff5d : #0000005c;

    // Accent (UISettings accent shades are pushed by Rust in the real app).
    // AccentFillColorDefault: light = AccentDark1, dark = AccentLight2.
    in-out property <brush> accent: dark ? #60cdff : #005fb8;
    in-out property <brush> accent-hover: dark ? #5abce9 : #1a6fc2;
    // AccentTextFillColorPrimary: light = AccentDark2, dark = AccentLight3.
    in-out property <brush> accent-text: dark ? #99ebff : #003e92;
    // TextOnAccentFillColorPrimary
    out property <brush> text-on-accent: dark ? #000000 : #ffffff;

    // System fills
    out property <brush> success: dark ? #6ccb5f : #0f7b0f;
    out property <brush> critical: dark ? #ff99a4 : #c42b1c;
    out property <brush> caution: dark ? #fce100 : #9d5d00;
    // InfoBar error severity background (SystemFillColorCriticalBackground)
    out property <brush> critical-background: dark ? #442726 : #fde7e9;

    // Metrics
    out property <length> title-bar-height: 48px;
    out property <length> explorer-width: 280px;
    out property <length> caption-reserve: 140px;
    out property <length> corner-radius: 8px;
    out property <length> control-radius: 4px;
    out property <length> control-height: 32px;

    // Typography (Segoe UI Variable via the system font; icons via Segoe Fluent Icons, MDL2 fallback).
    out property <string> icon-font: "Segoe Fluent Icons";
    out property <length> caption-size: 12px;
    out property <length> body-size: 14px;
    out property <length> subtitle-size: 20px;
}
