// Building blocks of the Windows hub (win-ui-hub-settings §3–§5): the hub's hard-coded colors (dark values exactly
// as in the WinUI app; light values contrast-corrected from the Fluent tokens, UNIFIED.md §3.9 FIX-W), padded
// buttons and pills, badges, star buttons and the menu flyout over `HubBridge.menu-entries`.
import { MenuEntry } from "../../shared/main_types.slint";
import { HubBridge } from "../../shared/bridge.slint";
import { Theme } from "../theme.slint";
import { Glyph, ToolTip } from "../main/controls.slint";

// WinUI `#AARRGGBB` literals of VideoPlatformControls.cs, written as Slint `#RRGGBBAA`.
export global HubColors {
    out property <bool> dark: Theme.dark;
    // Filter / list pills: active `#FF2B7AFF` white; inactive `#1E808088` / `#DFFFFFFF`.
    out property <brush> pill-active: #2b7aff;
    out property <brush> pill-inactive: dark ? #8080881e : Theme.subtle-hover;
    out property <brush> pill-inactive-hover: dark ? #80808836 : Theme.subtle-pressed.darker(0.3);
    out property <brush> pill-inactive-text: dark ? #ffffffdf : Theme.text-primary;
    // List pills: `#22808088` (inactive).
    out property <brush> list-pill-inactive: dark ? #80808822 : #00000012;
    out property <brush> list-pill-text: dark ? #ffffff : Theme.text-primary;
    // Lists bar `#1480808A` / border `#2480808A`.
    out property <brush> lists-bar: #80808a14;
    out property <brush> lists-bar-stroke: #80808a24;
    // Auth card `#18808088` / `#30808088`, icon badge `#28388BFF`.
    out property <brush> auth-card: #80808818;
    out property <brush> auth-card-stroke: #80808830;
    out property <brush> auth-icon: #388bff28;
    out property <brush> error-text: dark ? #ff6b6b : #c42b1c;
    // Video card `#1C80808A` / `#2A80808A`.
    out property <brush> card: #80808a1c;
    out property <brush> card-hover: #80808a2a;
    out property <brush> card-stroke: #80808a2a;
    // Badges row (light variants from the Fluent success/critical/caution/accent text tokens).
    out property <brush> subtitle-badge: #1e8e5a33;
    out property <brush> subtitle-badge-text: dark ? #6ef2b4 : #0f7b0f;
    out property <brush> no-subtitle-badge: #80808a22;
    out property <brush> no-subtitle-text: dark ? #ffffff99 : Theme.text-secondary;
    out property <brush> liked-badge: #ff4d6d33;
    out property <brush> liked-badge-text: dark ? #ff859d : #b4123c;
    out property <brush> rated-badge: #ffc83d33;
    out property <brush> rated-badge-text: dark ? #ffd86b : #9d5d00;
    out property <brush> list-badge: #2b7aff33;
    out property <brush> list-badge-text: dark ? #8cb8ff : Theme.accent-text;
    // Hearts and stars (on the theme background for cards; the engagement bar is always on the dark video).
    out property <brush> heart: #ff4d6d;
    out property <brush> star-gold: #ffc83d;
    out property <brush> star-empty-card: dark ? #ffffff80 : #00000060;
    out property <brush> heart-empty-card: Theme.text-primary;
}

// A padded Fluent button (`Button` with explicit Padding/CornerRadius in code-behind): default or accent fill,
// optional glyph (Segoe Fluent) before the label.
export component HubButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 12px;
    in property <brush> glyph-color: root.fg;
    in property <string> label;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <length> pad-x: 10px;
    in property <length> pad-y: 5px;
    in property <length> radius: 6px;
    in property <length> gap: 6px;
    in property <bool> accent;
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <string> accessible-name;
    callback clicked();
    border-radius: root.radius;
    border-width: 1px;
    border-color: root.accent ? #ffffff14 : Theme.control-stroke;
    background: !root.enabled ? (root.accent ? Theme.control-strong-fill-disabled : Theme.control-fill)
        : root.accent ? (touch.pressed ? Theme.accent.with-alpha(0.8) : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    property <brush> fg: !root.enabled ? Theme.text-disabled : root.accent ? Theme.text-on-accent : Theme.text-primary;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : (root.label != "" ? root.label : root.tooltip);
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;
        alignment: center;
        if root.glyph != "": Glyph {
            glyph: root.glyph;
            size: root.glyph-size;
            color: root.glyph-color;
        }
        if root.label != "": Text {
            text: root.label;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
            color: root.fg;
            overflow: elide;
        }
        @children
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// A rounded pill button with explicit colors (filter pills, list pills, chips).
export component HubPill inherits Rectangle {
    in property <string> label;
    in property <length> font-size: 12.5px;
    in property <int> font-weight: 600;
    in property <length> pad-x: 12px;
    in property <length> pad-y: 6px;
    in property <length> radius: 16px;
    in property <brush> fill;
    in property <brush> hover-fill: root.fill;
    in property <brush> text-color;
    in property <bool> selected;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    border-radius: root.radius;
    background: touch.has-hover && root.enabled ? root.hover-fill : root.fill;
    opacity: touch.pressed ? 0.8 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        Text {
            text: root.label;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.text-color;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// Standard badge (padding 6,2, radius 5, 10.5 SemiBold) with an optional glyph.
export component HubBadge inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <brush> fill;
    in property <brush> text-color;
    in property <brush> stroke: transparent;
    in property <length> font-size: 10.5px;
    in property <int> font-weight: 600;
    in property <length> radius: 5px;
    in property <length> pad-x: 6px;
    in property <length> pad-y: 2px;
    in property <string> tooltip;
    // A text symbol before `text` (e.g. "☰"), drawn with the symbol font: Segoe UI has no U+2630 and the WinUI
    // text stack falls back to Segoe UI Symbol for it.
    in property <string> symbol;
    // Intrinsic size also when placed freely (thumbnail overlays).
    width: self.preferred-width;
    height: self.preferred-height;
    border-radius: root.radius;
    background: root.fill;
    border-width: root.stroke == transparent ? 0 : 1px;
    border-color: root.stroke;
    accessible-role: AccessibleRole.text;
    accessible-label: root.symbol != "" ? root.symbol + " " + root.text : root.text;
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 4px;
        if root.glyph != "": Glyph {
            glyph: root.glyph;
            size: 11px;
            color: root.text-color;
        }
        if root.symbol != "": Text {
            text: root.symbol;
            font-family: "Segoe UI Symbol";
            font-size: root.font-size;
            color: root.text-color;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.text-color;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover;
    }
}

// A transparent star button (no border): `E735` gold when lit, else `E734`.
export component StarButton inherits Rectangle {
    in property <int> star;
    in property <bool> lit;
    in property <length> glyph-size: 13px;
    in property <brush> empty-color;
    in property <length> pad-x: 4px;
    in property <length> pad-y: 2px;
    in property <length> radius: 4px;
    in property <string> label;
    // Not hit-testable while false (the engagement bar hidden with the HUD).
    in property <bool> enabled: true;
    callback clicked();
    min-width: 24px;
    min-height: 24px;
    border-radius: root.radius;
    background: !root.enabled ? transparent : touch.pressed ? #ffffff10 : touch.has-hover ? #ffffff18 : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        alignment: center;
        Glyph {
            glyph: root.lit ? "\u{E735}" : "\u{E734}";
            size: root.glyph-size;
            color: root.lit ? HubColors.star-gold : root.empty-color;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.label;
        show: root.enabled && touch.has-hover && !touch.pressed;
    }
}

component HubMenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> any-indicator;
    in property <bool> any-icon;
    callback activated();
    height: root.entry.separator ? 9px : 32px;
    border-radius: Theme.control-radius;
    background: root.entry.separator || !root.entry.enabled ? transparent : (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent);
    accessible-role: button;
    accessible-label: root.entry.title;
    accessible-checkable: root.entry.checkable;
    accessible-checked: root.entry.checked;
    accessible-enabled: root.entry.enabled;
    accessible-action-default => { if (root.entry.enabled) { root.activated(); } }
    if root.entry.separator: Rectangle {
        y: 4px;
        height: 1px;
        x: -4px;
        width: parent.width + 8px;
        background: Theme.divider;
    }
    property <brush> fg: root.entry.enabled ? (root.entry.destructive ? Theme.critical : Theme.text-primary) : Theme.text-disabled;
    if !root.entry.separator: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        if root.any-indicator: Rectangle {
            width: 16px;
            if root.entry.checked: Glyph {
                glyph: "\u{E73E}";
                size: 12px;
                color: root.fg;
            }
        }
        if root.any-icon: Rectangle {
            width: 16px;
            if root.entry.glyph != "": Glyph {
                glyph: root.entry.glyph;
                size: 16px;
                color: root.fg;
            }
        }
        Text {
            text: root.entry.title;
            font-size: Theme.body-size;
            vertical-alignment: center;
            color: root.fg;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.entry.enabled && !root.entry.separator;
        clicked => { root.activated(); }
    }
}

// MenuFlyout over `HubBridge.menu-entries` (add-to-list menu, §4.1): toggle items with check marks, separator,
// the quick-create item with glyph E710.
export component HubMenuFlyout inherits PopupWindow {
    in property <length> min-menu-width: 240px;
    property <[MenuEntry]> entries: HubBridge.menu-entries;
    Rectangle {
        background: Theme.flyout-background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.flyout-stroke;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000040;
        min-width: root.min-menu-width;
        VerticalLayout {
            padding: 4px;
            for e in root.entries: HubMenuRow {
                entry: e;
                any-indicator: root.any-checkable(root.entries);
                any-icon: root.any-glyph(root.entries);
                activated => {
                    HubBridge.menu-activated(e.id);
                    root.close();
                }
            }
        }
    }
    // Lists come first (checkable); the quick-create item (glyph) is always last; logged out = one plain item.
    pure function any-checkable(list: [MenuEntry]) -> bool {
        return list.length > 0 && list[0].checkable;
    }
    pure function any-glyph(list: [MenuEntry]) -> bool {
        return list.length > 1 || (list.length == 1 && list[0].glyph != "");
    }
}
