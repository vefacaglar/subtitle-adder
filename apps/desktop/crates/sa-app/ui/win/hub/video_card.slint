// Windows hub video card (win-ui-hub-settings §5.5): 192×108 thumbnail with its badges/pills/progress, then title,
// folder, the badges row and the actions row (Oynat; logged in: like, stars, "+ Listeye ekle").
import { Loc } from "../../shared/loc.slint";
import { HubBridge, HubCardData } from "../../shared/bridge.slint";
import { Theme } from "../theme.slint";
import { Glyph, ToolTip } from "../main/controls.slint";
import { HubButton, HubBadge, HubColors, StarButton, HubMenuFlyout } from "hub_controls.slint";

export component VideoCard inherits Rectangle {
    in property <HubCardData> card;
    in property <int> index;
    in property <bool> logged-in: HubBridge.is-logged-in;
    border-radius: 12px;
    background: HubColors.card;
    border-width: 1px;
    border-color: HubColors.card-stroke;
    accessible-role: groupbox;
    accessible-label: root.card.accessible-label;

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        // ---- thumbnail
        thumb := Rectangle {
            width: 192px;
            height: 108px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            clip: true;
            background: @linear-gradient(135deg, #161822 0%, #252a3a 100%);
            if root.card.has-thumbnail: Image {
                width: parent.width;
                height: parent.height;
                source: root.card.thumbnail;
                image-fit: cover;
                accessible-role: none;
            }
            // Play circle 38×38.
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: #000000b8;
                border-width: 1px;
                border-color: #ffffff55;
                Glyph {
                    x: (parent.width - self.width) / 2 + 2px;
                    glyph: "\u{E768}";
                    size: 15px;
                    color: white;
                }
            }
            // Top-left subtitle badge.
            if root.card.has-subtitle: HubBadge {
                x: 7px;
                y: 7px;
                radius: 4px;
                fill: #1e8e5ae6;
                glyph: "\u{F2B7}";
                text: root.card.subtitle-badge != "" ? root.card.subtitle-badge : Loc.t("Altyazılı");
                font-size: 10px;
                font-weight: 700;
                text-color: white;
                tooltip: Loc.t("Altyazı / çeviri dosyası mevcut");
            }
            if !root.card.has-subtitle: HubBadge {
                x: 7px;
                y: 7px;
                radius: 4px;
                fill: #1a1a2298;
                stroke: #ffffff38;
                text: Loc.t("Altyazı yok");
                font-size: 9.5px;
                font-weight: 400;
                text-color: #ffffffb8;
                tooltip: Loc.t("Altyazı yok");
            }
            // Top-right views pill.
            views := HubBadge {
                x: parent.width - self.width - 7px;
                y: 7px;
                radius: 4px;
                fill: #000000c8;
                text: root.card.views-text;
                text-color: white;
            }
            // Bottom-right duration pill.
            if root.card.duration-text != "": HubBadge {
                x: parent.width - self.width - 7px;
                y: parent.height - self.height - 9px;
                radius: 4px;
                pad-x: 5px;
                pad-y: 1px;
                fill: #000000d0;
                text: root.card.duration-text;
                font-weight: 400;
                text-color: white;
            }
            // Watch progress.
            if root.card.has-progress: Rectangle {
                y: parent.height - 4px;
                height: 4px;
                background: #ffffff55;
                Rectangle {
                    x: 0;
                    width: clamp(192px * root.card.progress, 4px, 192px);
                    height: 4px;
                    background: #ff2e4c;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { HubBridge.card-play(root.index); }
            }
        }
        // ---- details
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: center;
            title := Text {
                text: root.card.title;
                font-size: 14.5px;
                font-weight: 600;
                overflow: elide;
                color: Theme.text-primary;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HubBridge.card-play(root.index); }
                }
            }
            Text {
                text: root.card.folder;
                font-size: 11.5px;
                opacity: 0.68;
                overflow: elide;
                color: Theme.text-primary;
            }
            // Badges row.
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.card.watch-line;
                    font-size: 11.5px;
                    opacity: 0.78;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Theme.text-primary;
                }
                if root.card.has-subtitle: HubBadge {
                    fill: HubColors.subtitle-badge;
                    glyph: "\u{F2B7}";
                    text: root.card.subtitle-status;
                    text-color: HubColors.subtitle-badge-text;
                    tooltip: Loc.t("Altyazı / çeviri dosyası mevcut");
                }
                if !root.card.has-subtitle: HubBadge {
                    fill: HubColors.no-subtitle-badge;
                    text: root.card.subtitle-status;
                    text-color: HubColors.no-subtitle-text;
                    tooltip: Loc.t("Altyazı yok");
                }
                if root.card.is-liked: HubBadge {
                    fill: HubColors.liked-badge;
                    text: "♥ " + Loc.t("Favori");
                    text-color: HubColors.liked-badge-text;
                }
                if root.card.rating > 0: HubBadge {
                    fill: HubColors.rated-badge;
                    text: root.card.rating-badge;
                    text-color: HubColors.rated-badge-text;
                }
                for name in root.card.list-names: HubBadge {
                    fill: HubColors.list-badge;
                    text: "☰ " + name;
                    text-color: HubColors.list-badge-text;
                }
            }
            // Actions row (top margin 4).
            HorizontalLayout {
                padding-top: 4px;
                spacing: 8px;
                alignment: start;
                HubButton {
                    glyph: "\u{E768}";
                    glyph-size: 11px;
                    gap: 5px;
                    label: Loc.t("Oynat");
                    font-weight: 600;
                    pad-x: 10px;
                    pad-y: 4px;
                    clicked => { HubBridge.card-play(root.index); }
                }
                if root.logged-in: HubButton {
                    glyph: root.card.is-liked ? "\u{EB52}" : "\u{EB51}";
                    glyph-color: root.card.is-liked ? HubColors.heart : HubColors.heart-empty-card;
                    label: root.card.like-text;
                    pad-x: 10px;
                    pad-y: 4px;
                    clicked => { HubBridge.card-like(root.index); }
                }
                if root.logged-in: HorizontalLayout {
                    spacing: 1px;
                    for n in [1, 2, 3, 4, 5]: StarButton {
                        star: n;
                        lit: n <= root.card.rating;
                        empty-color: HubColors.star-empty-card;
                        label: Loc.t1("%lld yıldız", n);
                        clicked => { HubBridge.card-rate(root.index, root.card.rating == n ? 0 : n); }
                    }
                }
                if root.logged-in: HubButton {
                    glyph: "\u{E710}";
                    glyph-size: 11px;
                    gap: 5px;
                    label: Loc.t("+ Listeye ekle");
                    pad-x: 10px;
                    pad-y: 4px;
                    clicked => {
                        root.menu-x = self.absolute-position.x - root.absolute-position.x;
                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 4px;
                        HubBridge.menu-requested("add:" + root.index);
                        menu.show();
                    }
                }
            }
        }
    }
    // A PopupWindow cannot sit under a conditional: the add-to-list menu hangs off the card at the button.
    property <length> menu-x;
    property <length> menu-y;
    menu := HubMenuFlyout {
        x: root.menu-x;
        y: root.menu-y;
    }
}
