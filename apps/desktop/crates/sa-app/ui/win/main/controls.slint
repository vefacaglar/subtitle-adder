// Fluent building blocks the WinUI app uses and std-widgets lack (win-ui-main §5, §20.1): tool/icon/toggle buttons
// with Segoe Fluent glyphs, tooltips (≈400 ms), a menu flyout with radio/check/submenu items, a combo box with
// per-item disabled entries, an InfoBar.
import { Spinner } from "std-widgets.slint";
import { MenuEntry, PickerItem } from "../../shared/main_types.slint";
import { MainBridge } from "../../shared/bridge.slint";
import { Loc } from "../../shared/loc.slint";
import { Theme } from "../theme.slint";

// Hover tooltip: shows after ~400 ms below its parent, hides on exit/press.
export component ToolTip {
    in property <string> text;
    in property <bool> show;
    property <bool> shown;
    width: 0;
    height: 0;
    timer := Timer {
        interval: 400ms;
        running: root.show && !root.shown && root.text != "";
        triggered => {
            root.shown = true;
            popup.show();
        }
    }
    changed show => {
        if (!root.show) {
            root.shown = false;
            popup.close();
        }
    }
    popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0;
        y: 36px;
        Rectangle {
            background: Theme.tooltip-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.flyout-stroke;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000030;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 5px;
                padding-bottom: 7px;
                Text {
                    text: root.text;
                    font-size: 12px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                    max-width: 320px;
                }
            }
        }
    }
}

// A Segoe Fluent Icons glyph.
export component Glyph inherits Text {
    in property <string> glyph;
    in property <length> size: 16px;
    text: self.glyph;
    font-family: Theme.icon-font;
    font-size: self.size;
    vertical-alignment: center;
    horizontal-alignment: center;
    accessible-role: none;
}

// Fluent default button with an optional glyph and label (`ToolButtonStyle` padding 11,5; accent variant).
export component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 16px;
    in property <string> label;
    in property <bool> show-label: true;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> accent;
    in property <bool> subtle;
    in property <length> pad-x: 11px;
    in property <length> pad-y: 5px;
    callback clicked();
    min-height: Theme.control-height;
    min-width: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: root.subtle ? 0 : 1px;
    border-color: root.accent ? (Theme.dark ? #ffffff14 : #ffffff14) : Theme.control-stroke;
    background: !root.enabled ? (root.accent ? Theme.control-strong-fill-disabled : (root.subtle ? transparent : Theme.control-fill))
        : root.accent ? (touch.pressed ? Theme.accent.with-alpha(0.8) : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.subtle ? (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent)
        : (touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : (root.label != "" ? root.label : root.tooltip);
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    property <brush> fg: !root.enabled ? Theme.text-disabled : root.accent ? Theme.text-on-accent : Theme.text-primary;
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Glyph {
            glyph: root.glyph;
            size: root.glyph-size;
            color: root.fg;
        }
        if root.label != "" && root.show-label: Text {
            text: root.label;
            font-size: Theme.body-size;
            vertical-alignment: center;
            color: root.fg;
        }
        @children
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// ToggleButton (checked = accent fill), glyph only or glyph + label.
export component ToggleGlyph inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 16px;
    in property <string> label;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <length> pad-x: 8px;
    in property <length> pad-y: 5px;
    // Dark-forced variant for the player overlays.
    in property <bool> on-dark;
    in property <length> min-w: 0;
    callback toggled();
    min-height: root.on-dark ? 28px : Theme.control-height;
    min-width: root.min-w;
    border-radius: Theme.control-radius;
    border-width: root.on-dark ? 0 : 1px;
    border-color: Theme.control-stroke;
    property <brush> on-fill: root.on-dark ? #60cdff : Theme.accent;
    background: !root.enabled ? (root.checked ? (root.on-dark ? #ffffff28 : Theme.control-strong-fill-disabled) : (root.on-dark ? transparent : Theme.control-fill))
        : root.checked ? (touch.has-hover ? root.on-fill.with-alpha(0.9) : root.on-fill)
        : root.on-dark ? (touch.pressed ? #ffffff0a : touch.has-hover ? #ffffff15 : transparent)
        : (touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name != "" ? root.accessible-name : (root.label != "" ? root.label : root.tooltip);
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.toggled(); } }
    property <brush> fg: !root.enabled ? (root.on-dark ? #ffffff5d : Theme.text-disabled)
        : root.checked ? (root.on-dark ? #000000 : Theme.text-on-accent)
        : (root.on-dark ? #ffffff : Theme.text-primary);
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 6px;
        alignment: center;
        if root.glyph != "": Glyph {
            glyph: root.glyph;
            size: root.glyph-size;
            color: root.fg;
        }
        if root.label != "": Text {
            text: root.label;
            font-size: root.on-dark ? 13px : Theme.body-size;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: root.fg;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// One row of a menu flyout.
component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> any-indicator;
    in property <bool> any-icon;
    // Rows of the other menu level collapse (Slint cannot filter inside `for`).
    in property <bool> hidden;
    callback activated();
    callback submenu-hovered();
    height: root.hidden ? 0 : root.entry.separator ? 9px : 32px;
    visible: !root.hidden;
    border-radius: Theme.control-radius;
    background: root.entry.separator || !root.entry.enabled ? transparent : (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent);
    accessible-role: button;
    accessible-label: root.entry.title;
    accessible-checkable: root.entry.checkable;
    accessible-checked: root.entry.checked;
    accessible-enabled: root.entry.enabled;
    accessible-action-default => { if (root.entry.enabled) { root.activated(); } }
    if root.entry.separator: Rectangle {
        y: 4px;
        height: 1px;
        x: -4px;
        width: parent.width + 8px;
        background: Theme.divider;
    }
    property <brush> fg: root.entry.enabled ? (root.entry.destructive ? Theme.critical : Theme.text-primary) : Theme.text-disabled;
    if !root.entry.separator: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        if root.any-indicator: Rectangle {
            width: 16px;
            if root.entry.checked && root.entry.radio: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.fg;
            }
            if root.entry.checked && !root.entry.radio: Glyph {
                glyph: "\u{E73E}";
                size: 12px;
                color: root.fg;
            }
        }
        if root.any-icon: Rectangle {
            width: 16px;
            if root.entry.glyph != "": Glyph {
                glyph: root.entry.glyph;
                size: 16px;
                color: root.entry.tint.alpha > 0 ? root.entry.tint : root.fg;
            }
        }
        Text {
            text: root.entry.title;
            font-size: Theme.body-size;
            vertical-alignment: center;
            color: root.fg;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.entry.hint != "": Text {
            text: root.entry.hint;
            font-size: Theme.caption-size;
            vertical-alignment: center;
            color: Theme.text-secondary;
        }
        if root.entry.submenu: Glyph {
            glyph: "\u{E76C}";
            size: 12px;
            color: root.fg;
        }
    }
    touch := TouchArea {
        enabled: root.entry.enabled && !root.entry.separator;
        clicked => {
            if (root.entry.submenu) {
                root.submenu-hovered();
            } else {
                root.activated();
            }
        }
        changed has-hover => {
            if (self.has-hover && root.entry.submenu) {
                root.submenu-hovered();
            }
        }
    }
}

// MenuFlyout: the entries of `MainBridge.menu-entries` (level 0) and one cascading submenu (level 1).
export component MenuFlyout inherits PopupWindow {
    in property <length> min-menu-width: 200px;
    property <[MenuEntry]> entries: MainBridge.menu-entries;
    property <length> sub-y;

    Rectangle {
        background: Theme.flyout-background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.flyout-stroke;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000040;
        min-width: root.min-menu-width;
        VerticalLayout {
            padding: 4px;
            spacing: 0;
            for e[i] in root.entries: MenuRow {
                entry: e;
                hidden: e.level != 0;
                any-indicator: root.has-indicator(root.entries);
                any-icon: root.has-icon(root.entries);
                activated => {
                    MainBridge.menu-activated(e.id);
                    root.close();
                }
                submenu-hovered => {
                    root.sub-y = self.y;
                    sub.show();
                }
            }
        }
    }

    sub := PopupWindow {
        x: root.min-menu-width - 6px;
        y: root.sub-y;
        Rectangle {
            background: Theme.flyout-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.flyout-stroke;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            min-width: 140px;
            VerticalLayout {
                padding: 4px;
                for e in root.entries: MenuRow {
                    entry: e;
                    hidden: e.level != 1;
                    any-indicator: true;
                    any-icon: false;
                    activated => {
                        MainBridge.menu-activated(e.id);
                        sub.close();
                        root.close();
                    }
                }
            }
        }
    }

    pure function has-indicator(list: [MenuEntry]) -> bool {
        // Slint has no array reductions; menus are short, so check the first 12 entries.
        return (list.length > 0 && list[0].checkable) || (list.length > 1 && list[1].checkable) || (list.length > 2 && list[2].checkable)
            || (list.length > 3 && list[3].checkable) || (list.length > 4 && list[4].checkable) || (list.length > 5 && list[5].checkable)
            || (list.length > 6 && list[6].checkable) || (list.length > 7 && list[7].checkable) || (list.length > 8 && list[8].checkable)
            || (list.length > 9 && list[9].checkable) || (list.length > 10 && list[10].checkable) || (list.length > 11 && list[11].checkable);
    }
    pure function has-icon(list: [MenuEntry]) -> bool {
        return (list.length > 0 && list[0].glyph != "") || (list.length > 1 && list[1].glyph != "") || (list.length > 2 && list[2].glyph != "")
            || (list.length > 3 && list[3].glyph != "") || (list.length > 4 && list[4].glyph != "") || (list.length > 5 && list[5].glyph != "")
            || (list.length > 6 && list[6].glyph != "") || (list.length > 7 && list[7].glyph != "") || (list.length > 8 && list[8].glyph != "")
            || (list.length > 9 && list[9].glyph != "") || (list.length > 10 && list[10].glyph != "") || (list.length > 11 && list[11].glyph != "");
    }
}

// DropDownButton: label content + chevron; opens `MenuFlyout` with the entries Rust provides for `menu-id`.
export component DropDownButton inherits Rectangle {
    in property <string> menu-id;
    in property <string> glyph;
    in property <length> glyph-size: 16px;
    in property <float> glyph-opacity: 1;
    in property <brush> glyph-color: Theme.text-primary;
    in property <string> label;
    in property <bool> show-label: true;
    in property <length> label-min-width: 0;
    in property <bool> stretch-label;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <length> pad-x: 11px;
    in property <length> menu-width: 200px;
    // Opens a custom flyout instead of the menu (translation model picker).
    callback custom-clicked();
    in property <bool> custom;
    min-height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: !root.enabled ? Theme.control-fill : (touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    accessible-role: combobox;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.label;
    accessible-value: root.label;
    accessible-enabled: root.enabled;
    // UIA Invoke/Expand opens it like a click (WinUI DropDownButton is invokable).
    accessible-action-default => { root.open(); }
    function open() {
        if (!root.enabled) {
            return;
        }
        if (root.custom) {
            root.custom-clicked();
        } else {
            MainBridge.menu-requested(root.menu-id);
            flyout.show();
        }
    }
    property <brush> fg: root.enabled ? Theme.text-primary : Theme.text-disabled;
    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: 8px;
        spacing: 8px;
        if root.glyph != "": Glyph {
            glyph: root.glyph;
            size: root.glyph-size;
            opacity: root.glyph-opacity;
            color: root.enabled ? root.glyph-color : Theme.text-disabled;
        }
        @children
        if root.label != "" && root.show-label: Text {
            text: root.label;
            min-width: root.label-min-width;
            horizontal-stretch: root.stretch-label ? 1 : 0;
            font-size: Theme.body-size;
            vertical-alignment: center;
            overflow: elide;
            color: root.fg;
        }
        Glyph {
            glyph: "\u{E70D}";
            size: 10px;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open(); }
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
    flyout := MenuFlyout {
        x: 0;
        y: root.height + 4px;
        min-menu-width: max(root.width, root.menu-width);
    }
}

// ComboBox whose items can be individually disabled (TargetBox, ExportLanguageBox).
export component PickerCombo inherits Rectangle {
    in property <[PickerItem]> items;
    in property <int> current-index;
    in property <string> tooltip;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    callback selected(int);
    // WinUI ComboBox keyboard: focusable (Tab, or `focus()` from a flyout that opens on it), ↑/↓ select the
    // previous/next enabled item, Space / Return / Alt+↓ / F4 open the list. The focus ring (FocusVisualPrimaryBrush
    // 2 px around the control) shows only for keyboard focus, like WinUI.
    forward-focus: keys;
    property <bool> keyboard-focus;
    min-height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: !root.enabled ? Theme.control-fill : (touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill);
    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.items.length ? root.items[root.current-index].title : "";
    accessible-enabled: root.enabled;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.items.length ? root.items[root.current-index].title : "";
            font-size: Theme.body-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
        Glyph {
            glyph: "\u{E70D}";
            size: 10px;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    function step(delta: int) {
        if (root.items.length == 0) {
            return;
        }
        let start = max(0, root.current-index);
        if (delta > 0 && start + 1 < root.items.length && root.items[start + 1].enabled) {
            root.selected(start + 1);
        } else if (delta < 0 && start > 0 && root.items[start - 1].enabled) {
            root.selected(start - 1);
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost => { root.keyboard-focus = false; }
        key-pressed(event) => {
            if (event.text == Key.UpArrow && !event.modifiers.alt) {
                root.step(-1);
                return accept;
            }
            if (event.text == Key.DownArrow && !event.modifiers.alt) {
                root.step(1);
                return accept;
            }
            if (event.text == " " || event.text == Key.Return || event.text == Key.F4 || (event.text == Key.DownArrow && event.modifiers.alt)) {
                popup.show();
                return accept;
            }
            reject
        }
    }
    if keys.has-focus && root.keyboard-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.text-primary;
    }
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
    popup := PopupWindow {
        x: 0;
        // WinUI opens the list over the control, the selected item aligned with it.
        y: - max(0, root.current-index) * 36px - 4px;
        width: root.width;
        Rectangle {
            background: Theme.flyout-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.flyout-stroke;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.items: Rectangle {
                    height: 36px;
                    border-radius: Theme.control-radius;
                    background: !item.enabled ? transparent : (i == root.current-index ? Theme.subtle-hover : (rowtouch.has-hover ? Theme.subtle-hover : transparent));
                    if i == root.current-index: Rectangle {
                        x: 0;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                    Text {
                        x: 12px;
                        width: parent.width - 16px;
                        text: item.title;
                        font-size: Theme.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                        color: item.enabled ? Theme.text-primary : Theme.text-disabled;
                    }
                    rowtouch := TouchArea {
                        enabled: item.enabled;
                        clicked => {
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Vertical 1 px separator of the command bar (margin 2,6).
export component BarSeparator inherits Rectangle {
    width: 5px;
    Rectangle {
        x: 2px;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: Theme.divider;
    }
}

// Fluent InfoBar, error severity (win-ui-main §6.3): glyph, message, optional action button, close button.
export component InfoBar inherits Rectangle {
    in property <string> message;
    in property <string> action-label;
    in property <bool> action-visible;
    callback action();
    callback closed();
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: Theme.critical-background;
    min-height: 48px;
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 4px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - 16px) / 2;
            border-radius: 8px;
            background: Theme.critical;
            Glyph {
                glyph: "\u{F13D}";
                size: 10px;
                color: Theme.dark ? #000000 : #ffffff;
            }
        }
        Text {
            text: root.message;
            font-size: Theme.body-size;
            color: Theme.text-primary;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.action-visible: ToolButton {
            label: root.action-label;
            clicked => { root.action(); }
        }
        ToolButton {
            glyph: "\u{E711}";
            glyph-size: 12px;
            subtle: true;
            pad-x: 10px;
            accessible-name: Loc.t("Kapat");
            clicked => { root.closed(); }
        }
    }
}

// ProgressRing (indeterminate) as a std Spinner sized like WinUI.
export component ProgressRing inherits Spinner {
    indeterminate: true;
}
