// Fluent building blocks of the Settings window (win-ui-hub-settings §1.2 CardStyle / SectionHeaderStyle /
// SecondaryTextStyle, §6.2 card layout). Settings-local so the area stays independent of the main window's files.
import { Button, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Loc } from "../../shared/loc.slint";
import { ToolTip } from "../main/controls.slint";

export { ToolTip }

// Segoe Fluent Icons glyph.
export component Glyph inherits Text {
    in property <string> glyph;
    text: root.glyph;
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text-primary;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

// SectionHeaderStyle: BodyStrong, margin 1,24,0,6 (the first header of a page: 1,8,0,6).
export component SectionHeader inherits VerticalLayout {
    in property <string> text;
    in property <bool> first;
    padding-left: 1px;
    padding-top: root.first ? 8px : 24px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        font-size: Theme.body-size;
        font-weight: 600;
        color: Theme.text-primary;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
}

// SecondaryTextStyle: Caption, TextFillColorSecondary, wrap.
export component SecondaryText inherits Text {
    font-size: Theme.caption-size;
    color: Theme.text-secondary;
    wrap: word-wrap;
    horizontal-alignment: left;
}

// CardStyle border: CardBackground, CardStroke 1 px, radius 8, padding 16×12, MinHeight 64.
export component CardFrame inherits Rectangle {
    background: Theme.card-background;
    border-color: Theme.card-stroke;
    border-width: 1px;
    border-radius: Theme.corner-radius;
    min-height: 64px;
}

// The generic settings card: [glyph 18] [title / caption] … [trailing control]. Without a glyph the text is indented
// by 34 (sub-card). `@children` is the trailing control.
export component SettingsCard inherits CardFrame {
    in property <string> glyph;
    in property <string> title;
    in property <string> caption;
    // Extra secondary line (opacity 0.85), e.g. the cache usage label.
    in property <string> detail;
    in property <bool> sub;
    in property <float> title-opacity: 1;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            padding-left: root.glyph == "" && root.sub ? 34px : 0px;
            if root.glyph != "": Glyph {
                glyph: root.glyph;
                font-size: 18px;
                width: 20px;
            }
            VerticalLayout {
                alignment: center;
                spacing: root.detail != "" ? 2px : 0px;
                Text {
                    text: root.title;
                    font-size: Theme.body-size;
                    color: Theme.text-primary;
                    opacity: root.title-opacity;
                    wrap: word-wrap;
                }
                if root.caption != "": SecondaryText { text: root.caption; }
                if root.detail != "": SecondaryText {
                    text: root.detail;
                    opacity: 0.85;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

// CardControlStyle: ComboBox MinWidth 220, vertically centered.
export component CardCombo inherits ComboBox {
    min-width: 220px;
}

// InfoBar (Success / Error / Informational), closable.
export component InfoBar inherits Rectangle {
    in property <bool> open;
    // 0 informational, 1 success, 2 error, 3 warning
    in property <int> severity;
    in property <string> message;
    in property <bool> closable: true;
    callback closed();
    visible: root.open;
    height: root.open ? self.preferred-height : 0px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: root.severity == 2 ? (Theme.dark ? #442726 : #fde7e9)
        : root.severity == 1 ? (Theme.dark ? #393d1b : #dff6dd)
        : root.severity == 3 ? (Theme.dark ? #433519 : #fff4ce)
        : (Theme.dark ? #ffffff0d : #f6f6f6);
    accessible-role: AccessibleRole.text;
    accessible-label: root.message;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 12px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: root.severity == 2 ? Theme.critical : root.severity == 1 ? Theme.success : root.severity == 3 ? Theme.caution : Theme.accent;
            Text {
                text: root.severity == 2 ? "\u{E894}" : root.severity == 1 ? "\u{E73E}" : root.severity == 3 ? "\u{E7BA}" : "\u{E946}";
                font-family: Theme.icon-font;
                font-size: 9px;
                color: Theme.dark ? #000000 : #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.message;
            font-size: Theme.body-size;
            color: Theme.text-primary;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-height: 40px;
        }
        if root.closable: Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            y: (parent.height - self.height) / 2;
            background: close-touch.has-hover ? Theme.subtle-hover : transparent;
            accessible-role: button;
            accessible-label: Loc.t("Kapat");
            Text {
                text: "\u{E711}";
                font-family: Theme.icon-font;
                font-size: 12px;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-touch := TouchArea { clicked => { root.closed(); } }
        }
    }
}

// A Fluent default button with a glyph and an optional label (std Button cannot show a font glyph).
export component GlyphButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked();
    min-width: row.preferred-width + (root.label != "" ? 24px : 16px);
    height: 32px;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: !root.enabled ? (Theme.dark ? #ffffff0b : #f9f9f94d)
        : touch.pressed ? Theme.control-fill-pressed : touch.has-hover ? Theme.control-fill-hover : Theme.control-fill;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width - 8px;
        background: Theme.control-stroke-bottom;
        visible: root.enabled && !touch.pressed;
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: root.label != "" ? 8px : 0px;
        Glyph {
            glyph: root.glyph;
            font-size: 14px;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
        if root.label != "": Text {
            text: root.label;
            font-size: Theme.body-size;
            color: root.enabled ? (touch.pressed ? Theme.text-secondary : Theme.text-primary) : Theme.text-disabled;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    // ToolTipService.ToolTip (a disabled button gets no pointer input, so no tooltip, as in WinUI).
    ToolTip {
        text: root.tooltip;
        show: touch.has-hover && !touch.pressed;
    }
}

// Editable ComboBox (WinUI `IsEditable`): a text box with a drop-down of known values. `committed` fires on
// selection, Enter and focus loss.
export component EditableCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback committed(string);
    callback edited(string);
    min-width: 160px;
    height: 32px;
    edit := LineEdit {
        width: 100%;
        height: 100%;
        text <=> root.text;
        placeholder-text: root.placeholder;
        enabled: root.enabled;
        accessible-label: root.accessible-name;
        edited(t) => { root.edited(t); }
        accepted(t) => { root.committed(t); }
        changed has-focus => {
            if (!self.has-focus) {
                root.committed(self.text);
            }
        }
    }
    // Chevron opening the list.
    Rectangle {
        x: parent.width - self.width - 4px;
        width: 28px;
        height: 24px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: chevron-touch.has-hover && root.enabled ? Theme.subtle-hover : Theme.dark ? #2d2d2d : #ffffff;
        visible: root.model.length > 0;
        Text {
            text: "\u{E70D}";
            font-family: Theme.icon-font;
            font-size: 12px;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        chevron-touch := TouchArea {
            enabled: root.enabled;
            clicked => { popup.show(); }
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.flyout-background;
            border-color: Theme.flyout-stroke;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 4px;
                for item in root.model: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: item-touch.has-hover ? Theme.subtle-hover : item == root.text ? Theme.subtle-pressed : transparent;
                    if item == root.text: Rectangle {
                        x: 0;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: item;
                        font-size: Theme.body-size;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.text = item;
                            root.committed(item);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// ContentDialog (theme of the window): title, content, primary + close buttons, close = default (Enter/Esc cancel).
export component ContentDialog inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    in property <string> primary-text;
    in property <string> close-text;
    callback primary();
    callback dismissed();
    visible: root.open;
    background: #0000004d;
    // Swallow clicks behind the dialog.
    TouchArea { }
    changed open => {
        if (root.open) {
            keys.focus();
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Return) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        card := Rectangle {
            width: min(548px, root.width - 48px);
            height: content.preferred-height;
            background: Theme.dark ? #2b2b2b : #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.dark ? #ffffff1a : #0000001a;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 8px;
            clip: true;
            content := VerticalLayout {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: root.title;
                        font-size: Theme.subtitle-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.message;
                        font-size: Theme.body-size;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                }
                Rectangle {
                    background: Theme.dark ? #202020 : #f3f3f3;
                    border-width: 0px;
                    HorizontalLayout {
                        padding: 24px;
                        spacing: 8px;
                        // ContentDialog buttons share the row equally.
                        Button {
                            // Equal preferred widths + equal stretch = equal columns.
                            preferred-width: 120px;
                            horizontal-stretch: 1;
                            text: root.primary-text;
                            clicked => { root.primary(); }
                        }
                        Button {
                            // Equal preferred widths + equal stretch = equal columns.
                            preferred-width: 120px;
                            horizontal-stretch: 1;
                            text: root.close-text;
                            primary: true;
                            clicked => { root.dismissed(); }
                        }
                    }
                }
            }
        }
    }
}
