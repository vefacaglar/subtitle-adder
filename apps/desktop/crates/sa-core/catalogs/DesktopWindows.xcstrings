{
  "sourceLanguage": "tr",
  "strings": {
    "API anahtarı şifrelenmemiş bağlantıyla (http) gönderilmez; adresi https:// ile girin.": {
      "comment": "Added by the Rust desktop app (enginekit connection-test errors, UNIFIED.md section 8, both platforms).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is not sent over an unencrypted (http) connection; enter the address with https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı şifrelenmemiş bağlantıyla (http) gönderilmez; adresi https:// ile girin."
          }
        }
      }
    },
    "Altyazı ve çeviri": {
      "comment": "Added by the Rust desktop app (UNIFIED.md section 8, Windows).",
