<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Behavior fixture for sa-core. Compiles the C# app's own SubtitleAdder.Core and EngineKit sources (linked read-only
    from apps/windows; nothing is built inside apps/windows) and prints what the real C# code returns for inputs the
    Rust test hands it (model labels and rows, sizes, byte sizes, times, hex colors, subtitle import and decoding,
    diagnostic path redaction, settings.json reads/writes, AtomicFileStore reads). See Program.cs for the commands.
    Globalization is NOT invariant: FormatByteSize needs the real tr-TR / en-US cultures.
    Build: dotnet build -c Release (bin/ and obj/ stay under this folder and are git-ignored).
    Used by crates/sa-core/tests/csharp_compat.rs (opt-in: SA_DOTNET_FIXTURES=1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS0618</NoWarn>
    <WinCore>..\..\..\..\windows\src\SubtitleAdder.Core</WinCore>
    <WinEngineKit>..\..\..\..\windows\src\EngineKit</WinEngineKit>
    <MacSources>..\..\..\..\macos\Sources</MacSources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(WinCore)\*.cs" LinkBase="Core" />
    <Compile Include="$(WinEngineKit)\*.cs" LinkBase="EngineKit" />
    <EmbeddedResource Include="$(MacSources)\SubtitleAdderApp\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.Core.Localizable.xcstrings" />
    <EmbeddedResource Include="$(WinCore)\Strings\Windows.xcstrings" LogicalName="SubtitleAdder.Core.Windows.xcstrings" />
    <EmbeddedResource Include="$(MacSources)\EngineKit\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.EngineKit.Localizable.xcstrings" />
  </ItemGroup>
</Project>
