<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Wire-compat fixture for sa-platform's single-instance pipe (win-ui-main §2). The C# app's
    SingleInstanceCoordinator derives its pipe name from Environment.UserName (not injectable), so this tool runs the
    same client/server code (NamedPipeClientStream/NamedPipeServerStream with PipeOptions.CurrentUserOnly,
    StreamWriter UTF-8 without BOM, WriteLine per path, ReadLine + Trim + Trim('"') + File.Exists + GetFullPath) on a
    test pipe name, so a real running app is never contacted:
      client <pipe> <path...>     forwards the paths (1200 ms connect timeout); prints ok or fail
      server <pipe> <count>       serves <count> connections; prints one line "batch|<n>" then one "path|<full>" per
                                  received path, per connection
      names <user>                prints SanitizeToken(<user>), the mutex and the pipe name
      assoc-register <scratch> <exe> [icon]
                                  runs FileAssociationRegistrar.Register with HKEY_CURRENT_USER redirected to
                                  HKCU\<scratch> (RegOverridePredefKey), so the user's real associations are untouched
      assoc-unregister <scratch>  the same for Unregister
      assoc-registered <scratch>  prints IsRegistered (true/false) under the redirected HKCU
      dump <scratch>              prints the subtree HKCU\<scratch> (one "key|name|kind|data" line per value, and
                                  "key|" per key, ordinal order) for byte-for-byte comparison
      fonts                       prints SystemFonts.Families (DirectWrite, SortedSet CurrentCultureIgnoreCase)
      paths <path...>             prints one JSON object per path: Path.GetPathRoot, Path.HasExtension,
                                  Path.GetFileNameWithoutExtension, MediaLibraryIndex.NormalizeDirectoryPath and
                                  LocalProfileManager's drive-root readiness rule
    Build: dotnet build -c Release (bin/ and obj/ stay under this folder).
    Used by crates/sa-platform/tests/csharp_compat.rs (opt-in: SA_DOTNET_FIXTURES=1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows-only fixture (registry, DirectWrite). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
