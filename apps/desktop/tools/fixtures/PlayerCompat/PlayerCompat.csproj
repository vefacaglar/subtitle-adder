<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Behavior fixture for sa-player. Compiles the C# app's own PlaybackTimeline.cs (PlaybackTimeline and
    PlayerSessionGate; linked read-only from apps/windows, nothing is built inside apps/windows) and replays an
    operation script on them, printing the result and the full state after every step (see Program.cs).
    Build: dotnet build -c Release (bin/ and obj/ stay under this folder and are git-ignored).
    Used by crates/sa-player/tests/csharp_compat.rs (opt-in: SA_DOTNET_FIXTURES=1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WinCore>..\..\..\..\windows\src\SubtitleAdder.Core</WinCore>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(WinCore)\PlaybackTimeline.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
