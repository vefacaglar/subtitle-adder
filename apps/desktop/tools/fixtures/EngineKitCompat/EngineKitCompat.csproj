<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Behavior fixture for sa-enginekit. Compiles the C# app's own EngineKit sources (linked read-only from
    apps/windows; nothing is built inside apps/windows) and prints what the real C# code returns for inputs the Rust
    test hands it:
      edit <cases.json>      runs sentence-editing operation sequences (SentenceEditing.cs) and prints one JSON line
                             per case: every operation's result, the final list encoded with EngineJson (the stdin
                             payload the engine receives) and where each final uid came from
      tracker <cases.json>   feeds stage sequences to DownloadPhaseTracker; one JSON line per case
      decode <lines.txt>     EngineEvent.Decode on every line; one JSON line per input line
      graphemes <lines.txt>  StringInfo.LengthInTextElements of every JSON string line
    Build: dotnet build -c Release (bin/ and obj/ stay under this folder and are git-ignored).
    Used by crates/sa-enginekit/tests/csharp_compat.rs (opt-in: SA_DOTNET_FIXTURES=1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS0618</NoWarn>
    <WinEngineKit>..\..\..\..\windows\src\EngineKit</WinEngineKit>
    <MacSources>..\..\..\..\macos\Sources</MacSources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(WinEngineKit)\*.cs" LinkBase="EngineKit" />
    <EmbeddedResource Include="$(MacSources)\EngineKit\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.EngineKit.Localizable.xcstrings" />
  </ItemGroup>
</Project>
