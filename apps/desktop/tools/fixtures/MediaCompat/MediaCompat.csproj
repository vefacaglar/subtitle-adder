<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Data-compat fixture for sa-media. Compiles the C# app's own SubtitleAdder.Core and EngineKit sources (linked
    read-only from apps/windows; nothing is built inside apps/windows) and drives the real MediaLibraryIndex,
    EncryptedVideoCacheStore, BufferedVideoStream and LocalProfileManager:
      index-write <dir>            builds a media tree under <dir>\tree and indexes it with the C# MediaLibraryIndex into
                                   <dir>\media-index.json (scan + crawl depth 2); prints total|dirs
      index-read <index> <folder>  loads <index> with the C# reader and prints total|dirs, then one line per cached file
                                   of <folder> (name|size|sidecarExt|lastWriteUtcTicks) and per subfolder (dir|path)
      index-dump <index> [query]   loads <index> and prints total|n, then per folder dir|path, sub|path and
                                   file|fullPath|name|dir|size|lastWriteTicks|hasSidecar|ext|indexedTicks, then the
                                   search(query, 500) order as search|fullPath
      cache-write <dir>          registers alice/pass123 (profiles.json in <dir>), plays <dir>\video.bin (known pattern)
                                   through BufferedVideoStream into <dir>\VideoCache; prints user|vaultKeyHex|identity|
                                   chunkSize|length
      cache-read <dir> <identity> <chunkSize> <length>
                                   logs alice in again; prints index|listed|sha256(plaintext) per chunk
      script <dir> <file>          runs a media-index script (ops listed in Program.cs) with the C# MediaLibraryIndex
      identity <path> <len> <cs>   prints EncryptedVideoCacheStore.ComputeVideoIdentity
      stream-trace <dir> <len> <cs> <maxCached> <ops>
                                   plays a pattern video through BufferedVideoStream + the C# cache (ops in Program.cs:
                                   seeks, reads, state/ratio dumps, reopen, logout/login, cache file counts)
      format-size <n>...  mime <path>...  badge <ext|-null>...
                                   FormatFileSize, GetMimeType, IndexedMediaFile.SidecarBadge per argument
      probe                        prints .NET path rules (GetPathRoot, NormalizeDirectoryPath)
    Build: dotnet build -c Release (bin/ and obj/ stay under this folder and are git-ignored).
    Used by crates/sa-media/tests/csharp_compat.rs (opt-in: SA_DOTNET_FIXTURES=1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- ICU casing, as the real app runs (ToUpperInvariant("ſ") is "S" there, "ſ" in invariant mode). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS0618</NoWarn>
    <WinCore>..\..\..\..\windows\src\SubtitleAdder.Core</WinCore>
    <WinEngineKit>..\..\..\..\windows\src\EngineKit</WinEngineKit>
    <MacSources>..\..\..\..\macos\Sources</MacSources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(WinCore)\*.cs" LinkBase="Core" />
    <Compile Include="$(WinEngineKit)\*.cs" LinkBase="EngineKit" />
    <EmbeddedResource Include="$(MacSources)\SubtitleAdderApp\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.Core.Localizable.xcstrings" />
    <EmbeddedResource Include="$(WinCore)\Strings\Windows.xcstrings" LogicalName="SubtitleAdder.Core.Windows.xcstrings" />
    <EmbeddedResource Include="$(MacSources)\EngineKit\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.EngineKit.Localizable.xcstrings" />
  </ItemGroup>
</Project>
