<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end data for the Rust desktop app (crates/sa-app/tests/e2e_windows.rs). Compiles the C# app's own
    SubtitleAdder.Core and EngineKit sources (linked read-only from apps/windows; nothing is built or restored inside
    apps/windows) and writes a realistic Windows data folder the way the C# app does:

      make <dataDir> <mediaDir>   profiles.json + profiles.db (profile "Emre" with history, likes, ratings, PNG
                                  thumbnails, a list), settings.json, media-index.json (scan of mediaDir) and
                                  translation-providers.json with one C#-written API-key provider
      dump <dataDir> <user> <pw>  what the C# app reads back (profiles, history, lists)

    Build: dotnet build -c Release (bin/ and obj/ stay under this folder and are git-ignored). Run it with TMP/TEMP
    pointing at a scratch folder so broker files and logs stay out of the real temp folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The real culture: list-name duplicates and sorting use CurrentCultureIgnoreCase like the app. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS0618</NoWarn>
    <WinCore>..\..\..\..\windows\src\SubtitleAdder.Core</WinCore>
    <WinEngineKit>..\..\..\..\windows\src\EngineKit</WinEngineKit>
    <MacSources>..\..\..\..\macos\Sources</MacSources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(WinCore)\*.cs" LinkBase="Core" />
    <Compile Include="$(WinEngineKit)\*.cs" LinkBase="EngineKit" />
    <EmbeddedResource Include="$(MacSources)\SubtitleAdderApp\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.Core.Localizable.xcstrings" />
    <EmbeddedResource Include="$(WinCore)\Strings\Windows.xcstrings" LogicalName="SubtitleAdder.Core.Windows.xcstrings" />
    <EmbeddedResource Include="$(MacSources)\EngineKit\Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.EngineKit.Localizable.xcstrings" />
  </ItemGroup>

</Project>
