  "strings": {
    " · çeviri: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " · çeviri: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · translation: %@"
          }
        }
      }
    },
    "%@ 0,1 sn geri": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 0,1 sn geri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: back 0.1 s"
          }
        }
      }
    },
    "%@ 0,1 sn ileri": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 0,1 sn ileri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: forward 0.1 s"
          }
        }
      }
    },
    "%@ boşalır. Tekrar kullanırsan yeniden indirilir.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boşalır. Tekrar kullanırsan yeniden indirilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be freed. It will be downloaded again if you use it later."
          }
        }
      }
    },
    "%@ boşaltıldı.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boşaltıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ freed."
          }
        }
      }
    },
    "%@ için API anahtarı Anahtar Zinciri'nden okunamadı. Erişime izin verip yeniden dene.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için API anahtarı Anahtar Zinciri'nden okunamadı. Erişime izin verip yeniden dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key for %@ could not be read from the Keychain. Allow access and try again."
          }
        }
      }
    },
    "%@ silindi; dosyalarını başka bir model de kullandığı için yer açılmadı.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silindi; dosyalarını başka bir model de kullandığı için yer açılmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deleted; no space was freed because another model uses its files."
          }
        }
      }
    },
    "%@ için %@ seçildi.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için %@ seçildi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected %2$@ for %1$@."
          }
        }
      }
    },
    "%@ modeli silinsin mi?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ modeli silinsin mi?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the %@ model?"
