{
  "sourceLanguage": "tr",
  "strings": {
    "Altyazı motoru bulunamadı (uv kurulu mu, ya da SUBTITLE_ENGINE ayarlı mı?).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı motoru bulunamadı (uv kurulu mu, ya da SUBTITLE_ENGINE ayarlı mı?)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitle engine not found (is uv installed, or is SUBTITLE_ENGINE set?)."
          }
        }
      }
    },
    "Motor başlatılamadı: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor başlatılamadı: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start the engine: %@"
          }
        }
      }
    },
    "Motor hata koduyla çıktı (%lld). %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor hata koduyla çıktı (%lld). %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine exited with an error code (%1$lld). %2$@"
          }
        }
      }
    },
    "Motor model listesi yazmadı.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor model listesi yazmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine did not output a model list."
          }
        }
      }
    },
    "Motor silme sonucunu yazmadı.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor silme sonucunu yazmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine did not output a deletion result."
          }
        }
      }
    },
    "Zaman aşımı": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman aşımı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out"
          }
        }
      }
    },
    "Yerel Ağ (Ollama / LM Studio)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel Ağ (Ollama / LM Studio)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local LAN (Ollama / LM Studio)"
          }
        }
      }
    },
    "Özel (OpenAI Uyumlu)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel (OpenAI Uyumlu)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom (OpenAI Compatible)"
          }
        }
      }
    },
    "API anahtarı geçersiz veya yetkisiz (HTTP %lld).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı geçersiz veya yetkisiz (HTTP %lld)."
          }
        },
        "en": {
