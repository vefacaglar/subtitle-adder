<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SubtitleAdder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SubtitleAdder"
    Title="Subtitle Adder">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="7" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Segoe UI digits are tabular, so times line up without a monospaced font. -->
            <x:String x:Key="MonoFont">Segoe UI Variable Text, Segoe UI</x:String>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (content extends into it; the caption buttons sit on the right). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Subtitle Adder" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleFile" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Command area -->
        <Grid x:Name="CommandBar" Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftToolsPanel" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Style="{StaticResource ToolButtonStyle}" Click="Open_Click" loc:Localize.ToolTip="Video dosyası seç (Ctrl+O)" loc:Localize.AutomationName="Video seç">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock x:Name="OpenLabel" loc:Localize.Text="Video seç" />
                    </StackPanel>
                </Button>
                <Button x:Name="ImportSubtitleButton" Style="{StaticResource ToolButtonStyle}" Click="ImportSubtitle_Click"
                        loc:Localize.ToolTip="Altyazı dosyası seç (.srt, .vtt, .ass) — yeniden ses ayırmadan yükle" loc:Localize.AutomationName="Altyazı aç">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                        <TextBlock x:Name="ImportSubtitleLabel" loc:Localize.Text="Altyazı aç" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="2,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ComboBox x:Name="LanguageBox" Width="165" VerticalAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged"
                          loc:Localize.AutomationName="Konuşma dili"
                          loc:Localize.ToolTip="Konuşma dili. Otomatik seçilirse model dili kendisi algılar; diğer modeller sabit dil listesiyle çalışır." />
                <DropDownButton x:Name="ModelButton" VerticalAlignment="Center" HorizontalContentAlignment="Left"
                                loc:Localize.AutomationName="Altyazı modeli"
                                loc:Localize.ToolTip="Daha doğru modeller daha yavaştır; ilk kullanımda indirilir.">
                    <TextBlock x:Name="ModelNameText" Text="{x:Bind Vm.ModelName, Mode=OneWay}" MinWidth="95" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModelFlyout" Placement="BottomEdgeAlignedLeft" Opening="ModelFlyout_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton x:Name="SpeakerButton" VerticalAlignment="Center" IsEnabled="{x:Bind loc:Ui.Not(Vm.IsWorking), Mode=OneWay}"
                                loc:Localize.AutomationName="Konuşmacılar"
                                loc:Localize.ToolTip="Videoda birden çok kişi konuşuyorsa kimin ne dediğini ayır; ilk kullanımda küçük bir model indirilir.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SpeakerIcon" Glyph="&#xE716;" FontSize="16" />
                        <TextBlock x:Name="SpeakerLabel" loc:Localize.Text="Konuşmacılar" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SpeakerFlyout" Placement="BottomEdgeAlignedLeft" Opening="SpeakerFlyout_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <StackPanel x:Name="TranslateGroup" Orientation="Horizontal" Spacing="8">
                    <Border Width="1" Margin="2,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ComboBox x:Name="TargetBox" Width="155" VerticalAlignment="Center" SelectionChanged="TargetBox_SelectionChanged"
                              IsEnabled="{x:Bind loc:Ui.Not(Vm.IsWorking), Mode=OneWay}" loc:Localize.AutomationName="Çeviri dili" />
                    <DropDownButton x:Name="TranslationModelButton" VerticalAlignment="Center" HorizontalContentAlignment="Left"
                                    IsEnabled="{x:Bind loc:Ui.Not(Vm.IsWorking), Mode=OneWay}"
                                    loc:Localize.AutomationName="Çeviri modeli"
                                    loc:Localize.ToolTip="Çeviri motoru (Gemma 4, Qwen 3.5, MADLAD, NLLB); ilk kullanımda indirilir.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE968;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind Vm.IsExternalLlmActive, Mode=OneWay}" />
                            <TextBlock x:Name="TranslationModelNameText" Text="{x:Bind Vm.TranslationModelName, Mode=OneWay}" MinWidth="95" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="TranslationModelFlyout" Placement="BottomEdgeAlignedLeft" Opening="TranslationModelFlyout_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="TranslateButton" Style="{StaticResource ToolButtonStyle}" Click="Translate_Click"
                            Visibility="Collapsed"
                            loc:Localize.ToolTip="Tüm satırları seçili hedef dile yerel modelle çevir" loc:Localize.AutomationName="Çevir…">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF2B7;" FontSize="16" />
                            <TextBlock x:Name="TranslateLabel" loc:Localize.Text="Çevir…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- View switcher: Real folder-style Tab Strip for Single-video editor vs. Batch playlist -->
            <Grid x:Name="TabBarPanel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,4,0,0">
                <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="EditorTabButton" Click="EditorTab_Click" Padding="14,7,14,9" CornerRadius="6,6,0,0"
                            BorderThickness="1,1,1,0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            loc:Localize.AutomationName="Düzenleyici">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE714;" FontSize="14" />
                                <TextBlock x:Name="EditorTabTitle" loc:Localize.Text="Düzenleyici" FontWeight="SemiBold" />
                            </StackPanel>
                            <Rectangle x:Name="EditorTabIndicator" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,-7"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Button>
                    <Button x:Name="PlaylistTabButton" Click="PlaylistTab_Click" Padding="14,7,14,9" CornerRadius="6,6,0,0"
                            BorderThickness="1,1,1,0" Background="Transparent" BorderBrush="Transparent"
                            loc:Localize.AutomationName="Çalma listesi">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE90B;" FontSize="14" />
                                <TextBlock x:Name="PlaylistTabTitle" loc:Localize.Text="Çalma listesi" />
                                <Border CornerRadius="8" Padding="6,1" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind Vm.HasPlaylistItems, Mode=OneWay}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Vm.PlaylistCount, Mode=OneWay}" FontSize="11" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <Rectangle x:Name="PlaylistTabIndicator" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,-7" Visibility="Collapsed"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="RightActionsPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <CheckBox x:Name="AutoSaveCheckBox" IsChecked="{x:Bind Vm.AutoSaveSubtitle, Mode=TwoWay}"
                          VerticalAlignment="Center" MinWidth="0" Margin="0,0,2,0"
                          loc:Localize.Content="Otomatik kaydet"
                          loc:Localize.ToolTip="Çeviri bittiğinde çevrilmiş altyazıyı otomatik olarak videonun klasörüne kaydet"
                          loc:Localize.AutomationName="Otomatik kaydet" />
                <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Click="Settings_Click"
                        loc:Localize.ToolTip="Ayarlar (Ctrl+,)" loc:Localize.AutomationName="Ayarlar">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button x:Name="GenerateButton" Style="{StaticResource ToolButtonStyle}" Padding="12,5" Click="Generate_Click"
                        loc:Localize.ToolTip="Videonun sesini metne çevirip altyazı çıkar (Ctrl+Enter)" loc:Localize.AutomationName="Altyazı üret">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                        <TextBlock x:Name="GenerateLabel" loc:Localize.Text="Altyazı üret" />
                    </StackPanel>
                </Button>
                <Button x:Name="GenerateAndTranslateButton" Style="{StaticResource AccentButtonStyle}" Padding="14,5" Click="GenerateAndTranslate_Click"
                        loc:Localize.ToolTip="Altyazıyı üret, seçili dile çevir ve otomatik kaydet" loc:Localize.AutomationName="Komple çevir">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF2B7;" FontSize="16" />
                        <TextBlock x:Name="GenerateAndTranslateLabel" loc:Localize.Text="Komple çevir" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource ToolButtonStyle}" Click="Cancel_Click"
                        Visibility="{x:Bind Vm.IsWorking, Mode=OneWay}"
                        loc:Localize.ToolTip="Süren altyazı ya da çeviri işini durdur" loc:Localize.AutomationName="Durdur">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock loc:Localize.Text="Durdur" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Margin="12,0,12,10" Severity="Error" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="GoOnlineButton" Click="GoOnlineButton_Click" Visibility="Collapsed"
                        loc:Localize.Content="Çevrimdışı modu kapat ve indir" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Content -->
        <Grid Grid.Row="3" Margin="12,0,12,0">
            <!-- Tab 1: Single-video editor (unchanged layout) -->
            <Grid x:Name="EditorView">
                <Grid x:Name="DropZone" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="5,4"
                               Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE714;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock loc:Localize.Text="Videoyu buraya sürükle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock loc:Localize.Text="ya da araç çubuğundan seç" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource ToolButtonStyle}" Click="Open_Click"
                                loc:Localize.AutomationName="Video seç">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                <TextBlock loc:Localize.Text="Video seç" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="WorkArea" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerRow" Height="5*" MinHeight="200" />
                        <RowDefinition x:Name="SplitterRow" Height="12" />
                        <RowDefinition x:Name="EditorRow" Height="4*" MinHeight="180" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayerCol" Width="*" />
                        <ColumnDefinition x:Name="SplitterCol" Width="0" />
                        <ColumnDefinition x:Name="EditorCol" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PlayerBorder" Grid.ColumnSpan="3" CornerRadius="8" Background="Black">
                        <Grid x:Name="PlayerGrid" SizeChanged="PlayerGrid_SizeChanged">
                            <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" Stretch="Uniform" RequestedTheme="Dark"
                                                loc:Localize.AutomationName="Video">
                                <MediaPlayerElement.TransportControls>
                                                                <MediaTransportControls IsCompact="True" />
                                </MediaPlayerElement.TransportControls>
                            </MediaPlayerElement>
                            <Grid x:Name="OverlayArea" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <loc:OverlayLabel x:Name="Overlay" />
                            </Grid>
                            <Border x:Name="DisplayPicker" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="10,4,4,4"
                                    CornerRadius="8" Background="#CC1C1C1E" BorderBrush="#40FFFFFF" BorderThickness="1" RequestedTheme="Dark">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock loc:Localize.Text="Gösterilen" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#D9FFFFFF" />
                                    <ToggleButton x:Name="DisplayOriginalButton" Padding="10,4" MinWidth="68" Click="DisplayOriginal_Click"
                                                  loc:Localize.Content="Orijinal" loc:Localize.AutomationName="Orijinal" />
                                    <ToggleButton x:Name="DisplayTranslationButton" Padding="10,4" MinWidth="68" Click="DisplayTranslation_Click"
                                                  loc:Localize.Content="Çeviri" loc:Localize.AutomationName="Çeviri" />
                                    <ToggleButton x:Name="DisplayBothButton" Padding="10,4" MinWidth="56" Click="DisplayBoth_Click"
                                                  loc:Localize.Content="İkisi" loc:Localize.AutomationName="İkisi" />
                                    <Border Width="1" Margin="4,4" Background="#40FFFFFF" />
                                    <ToggleButton x:Name="SideBySideButton" Padding="8,4" Click="SideBySide_Click"
                                                  loc:Localize.ToolTip="Altyazıları sağa / alta al"
                                                  loc:Localize.AutomationName="Altyazıları sağa / alta al">
                                        <FontIcon x:Name="SideBySideIcon" Glyph="&#xE89F;" FontSize="14" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="TheaterModeButton" Padding="8,4" Click="TheaterMode_Click"
                                                  loc:Localize.ToolTip="Tiyatro modu — üst menüleri gizle"
                                                  loc:Localize.AutomationName="Tiyatro modu">
                                        <FontIcon Glyph="&#xE799;" FontSize="14" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="FullScreenButton" Padding="8,4" Click="FullScreen_Click"
                                                  loc:Localize.ToolTip="Tam ekran (F11)"
                                                  loc:Localize.AutomationName="Tam ekran">
                                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <loc:SplitterHandle x:Name="Splitter" Grid.Row="1" Grid.ColumnSpan="3">
                        <Border x:Name="SplitterPill" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                    </loc:SplitterHandle>

                    <Border x:Name="EditorBorder" Grid.Row="2" Grid.ColumnSpan="3" SizeChanged="EditorBorder_SizeChanged" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Edit bar -->
                            <Grid x:Name="EditBar" Padding="12,6" ColumnSpacing="20" Visibility="{x:Bind Vm.HasSentences, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="StartControls" Orientation="Horizontal" Spacing="2">
                                    <TextBlock x:Name="StartLabel" loc:Localize.Text="Başlangıç" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button x:Name="StartMinus" Style="{StaticResource IconButtonStyle}" Click="StartMinus_Click"><FontIcon Glyph="&#xE738;" FontSize="12" /></Button>
                                    <TextBlock Text="{x:Bind Vm.SelectedStartText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
                                    <Button x:Name="StartPlus" Style="{StaticResource IconButtonStyle}" Click="StartPlus_Click"><FontIcon Glyph="&#xE710;" FontSize="12" /></Button>
                                    <Button x:Name="StartNow" Style="{StaticResource IconButtonStyle}" Click="StartNow_Click" loc:Localize.AutomationName="Şimdiki an"><FontIcon Glyph="&#xE81D;" FontSize="14" /></Button>
                                </StackPanel>
                                <StackPanel x:Name="EndControls" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock x:Name="EndLabel" loc:Localize.Text="Bitiş" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button x:Name="EndMinus" Style="{StaticResource IconButtonStyle}" Click="EndMinus_Click"><FontIcon Glyph="&#xE738;" FontSize="12" /></Button>
                                    <TextBlock Text="{x:Bind Vm.SelectedEndText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
                                    <Button x:Name="EndPlus" Style="{StaticResource IconButtonStyle}" Click="EndPlus_Click"><FontIcon Glyph="&#xE710;" FontSize="12" /></Button>
                                    <Button x:Name="EndNow" Style="{StaticResource IconButtonStyle}" Click="EndNow_Click" loc:Localize.AutomationName="Şimdiki an"><FontIcon Glyph="&#xE81D;" FontSize="14" /></Button>
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Padding="10,4" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{x:Bind Vm.IsTranslationInProgress, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind Vm.IsTranslationInProgress, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Vm.TranslationProgressBadgeText, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
                                    <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}" Click="Redo_Click"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
                                    <Border Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button x:Name="SplitButton" Style="{StaticResource IconButtonStyle}" Padding="9,5" Click="Split_Click"
                                            loc:Localize.ToolTip="Satırı oynatma konumundan ikiye böl">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C6;" FontSize="14" /><TextBlock x:Name="SplitLabel" loc:Localize.Text="Böl" /></StackPanel>
                                    </Button>
                                    <Button x:Name="MergeButton" Style="{StaticResource IconButtonStyle}" Padding="9,5" Click="Merge_Click" IsEnabled="{x:Bind Vm.CanMergeSelected, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71B;" FontSize="14" /><TextBlock x:Name="MergeLabel" loc:Localize.Text="Sonrakiyle birleştir" /></StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteButton" Style="{StaticResource IconButtonStyle}" Padding="9,5" Click="Delete_Click" IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}"
                                            loc:Localize.ToolTip="Satırı Sil (Delete)">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock x:Name="DeleteLabel" loc:Localize.Text="Sil" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{x:Bind Vm.HasSentences, Mode=OneWay}" />

                            <ListView x:Name="Lines" Grid.Row="2" ItemsSource="{x:Bind Rows}" SelectionMode="Single" Padding="0,4"
                                      SelectionChanged="Lines_SelectionChanged" PreviewKeyDown="Lines_PreviewKeyDown"
                                      Visibility="{x:Bind Vm.HasSentences, Mode=OneWay}" loc:Localize.AutomationName="Satırlar">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="MinHeight" Value="40" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="loc:SentenceRow">
                                        <Grid ColumnSpacing="10" Padding="0,4">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout Opening="RowMenu_Opening" />
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="4" Margin="-8,-4" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Opacity="0.16" Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind loc:Ui.Collapsed(IsActive), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,8,0,0"
                                                       VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="2" MinWidth="120" VerticalAlignment="Top" Padding="8,4" Click="SpeakerRow_Click"
                                                    Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderBrush="Transparent"
                                                    Visibility="{x:Bind ShowsSpeaker, Mode=OneWay}"
                                                    loc:Localize.ToolTip="Bu satırı söyleyen kişiyi değiştir" loc:Localize.AutomationName="Konuşmacıyı değiştir">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind SpeakerBrush, Mode=OneWay}" Visibility="{x:Bind HasSpeaker, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind SpeakerText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBox Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="96"
                                                         Background="Transparent" BorderThickness="0" Padding="6,5"
                                                         loc:Localize.PlaceholderText="Cümle" loc:Localize.AutomationName="Cümle"
                                                         GotFocus="LineText_GotFocus" LostFocus="LineText_LostFocus" TextChanged="LineText_TextChanged" KeyDown="LineText_KeyDown" />
                                                <Grid ColumnSpacing="6" Visibility="{x:Bind HasTranslation, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xF2B7;" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" loc:Localize.AutomationName="Çeviri" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind TranslationText, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="76"
                                                             Background="Transparent" BorderThickness="0" Padding="4,4" FontSize="13"
                                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                             loc:Localize.PlaceholderText="Çeviri" loc:Localize.AutomationName="Çeviri"
                                                             GotFocus="TranslationText_GotFocus" LostFocus="TranslationText_LostFocus"
                                                             TextChanged="TranslationText_TextChanged" KeyDown="TranslationText_KeyDown" />
                                                    <FontIcon Grid.Column="2" Glyph="&#xE81C;" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsStale, Mode=OneWay}"
                                                              loc:Localize.ToolTip="Orijinal metin değişti; çeviri eski olabilir. “Çevir…” ile yenile."
                                                              loc:Localize.AutomationName="Çeviri eski" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty state -->
                            <StackPanel x:Name="EmptyState" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind loc:Ui.Collapsed(Vm.HasSentences), Mode=OneWay}">
                                <FontIcon Glyph="&#xE7F0;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDetail" loc:Localize.Text="Araç çubuğundan “Altyazı üret”e bas." HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Tab 2: Batch playlist queue -->
            <Border x:Name="PlaylistPanel" Visibility="Collapsed" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Playlist toolbar -->
                    <Grid Padding="14,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddPlaylistVideosButton" Style="{StaticResource ToolButtonStyle}" Click="AddPlaylistVideos_Click"
                                    loc:Localize.ToolTip="Listeye birden fazla video dosyası ekle" loc:Localize.AutomationName="Videoları ekle…">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock x:Name="AddPlaylistVideosLabel" loc:Localize.Text="Videoları ekle…" />
                                </StackPanel>
                            </Button>
                            <DropDownButton x:Name="BulkPlaylistLanguageButton" VerticalAlignment="Center"
                                            IsEnabled="{x:Bind Vm.HasPlaylistItems, Mode=OneWay}"
                                            loc:Localize.ToolTip="Listedeki tüm videoların konuşma (kaynak) dilini tek seferde ayarla"
                                            loc:Localize.AutomationName="Tümünü ayarla">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock x:Name="BulkPlaylistLanguageLabel" loc:Localize.Text="Tüm kaynak diller" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="BulkPlaylistLanguageFlyout" Placement="BottomEdgeAlignedLeft" Opening="BulkPlaylistLanguageFlyout_Opening" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="ClearPlaylistButton" Style="{StaticResource ToolButtonStyle}" Click="ClearPlaylist_Click"
                                    IsEnabled="{x:Bind Vm.HasPlaylistItems, Mode=OneWay}"
                                    loc:Localize.ToolTip="Tamamlanan ve bekleyen videoları listeden temizle" loc:Localize.AutomationName="Listeyi temizle">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Name="ClearPlaylistLabel" loc:Localize.Text="Listeyi temizle" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Vm.PlaylistSummaryText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0" />
                        <Button x:Name="StartPlaylistButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Padding="14,6"
                                Click="StartPlaylist_Click"
                                loc:Localize.ToolTip="Listedeki tüm videoları sırayla metne çevir, seçili hedef dile çevir ve kendi klasörlerine kaydet"
                                loc:Localize.AutomationName="Tümünü Çevir ve Kaydet">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock loc:Localize.Text="Tümünü Çevir ve Kaydet" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Queued videos list -->
                    <ListView x:Name="PlaylistList" Grid.Row="2" ItemsSource="{x:Bind PlaylistRows}" SelectionMode="None" Padding="4,6"
                              Visibility="{x:Bind Vm.HasPlaylistItems, Mode=OneWay}" loc:Localize.AutomationName="Çalma listesi">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="MinHeight" Value="52" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="loc:PlaylistRow">
                                <Grid ColumnSpacing="14" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsWorking, Mode=OneWay}"
                                                      Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE930;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FolderPath, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" MinWidth="165" VerticalAlignment="Center" Padding="10,5"
                                            HorizontalContentAlignment="Stretch" Click="PlaylistItemLanguage_Click"
                                            IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                            loc:Localize.ToolTip="Bu videonun konuşma (kaynak) dilini seç"
                                            loc:Localize.AutomationName="Konuşma dili">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SourceLanguageTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="11" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" TextWrapping="Wrap" />
                                        <ProgressBar Maximum="1" Height="4"
                                                     Value="{x:Bind ProgressValue, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="RemovePlaylistItem_Click"
                                            IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                            loc:Localize.ToolTip="Listeden kaldır" loc:Localize.AutomationName="Listeden kaldır">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty playlist drop zone -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind loc:Ui.Collapsed(Vm.HasPlaylistItems), Mode=OneWay}">
                        <FontIcon Glyph="&#xE90B;" FontSize="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock loc:Localize.Text="Birden fazla videoyu buraya sürükle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock loc:Localize.Text="Listedeki tüm videolar sırayla seçili hedef dile çevrilip kendi klasörlerine kaydedilir."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource ToolButtonStyle}" Click="AddPlaylistVideos_Click"
                                loc:Localize.AutomationName="Videoları ekle…">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock loc:Localize.Text="Videoları ekle…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="16,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="StatusSpinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                <ProgressBar x:Name="Progress" Width="120" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
                <FontIcon x:Name="DoneIcon" Glyph="&#xE930;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                <FontIcon x:Name="FailIcon" Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="{x:Bind Vm.StatusText, Mode=OneWay}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
            <StackPanel x:Name="NoticePanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{x:Bind loc:Ui.VisibleIfText(Vm.ModelNoticeText), Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="NoticeText" Text="{x:Bind Vm.ModelNoticeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="FormatBox" MinWidth="90" SelectionChanged="FormatBox_SelectionChanged" loc:Localize.AutomationName="Biçim" />
                <ComboBox x:Name="ExportLanguageBox" MinWidth="150" SelectionChanged="ExportLanguageBox_SelectionChanged"
                          loc:Localize.AutomationName="Dil" loc:Localize.ToolTip="Dışa aktarılan altyazıda orijinal mi, çeviri mi kullanılsın" />
                <Button x:Name="SaveSubtitleButton" Click="SaveSubtitle_Click" IsEnabled="{x:Bind Vm.CanSaveSubtitle, Mode=OneWay}"
                        loc:Localize.ToolTip="Altyazıyı videonun bulunduğu klasöre videoyla aynı adla kaydet"
                        loc:Localize.AutomationName="Altyazıyı kaydet">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock x:Name="SaveSubtitleLabel" loc:Localize.Text="Altyazıyı kaydet" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="{x:Bind Vm.CanExport, Mode=OneWay}" loc:Localize.AutomationName="Dışa aktar…">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock x:Name="ExportLabel" loc:Localize.Text="Dışa aktar…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
