<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SubtitleAdder.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SubtitleAdder"
    xmlns:core="using:SubtitleAdder.Core">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardControlStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <DataTemplate x:Key="ModelRowTemplate" x:DataType="core:ModelRow">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsActive}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE720;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock loc:Localize.Text="Kullanılıyor" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{x:Bind LanguageSummary}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind StorageStatus}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind loc:SettingsWindow.RatingText(Model)}" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind LicenseText}" Style="{StaticResource SecondaryTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsNonCommercial}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock loc:Localize.Text="Ticari olmayan lisans" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ErrorText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind loc:Ui.VisibleIfText(ErrorText)}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind IsDeleting}">
                            <ProgressRing Width="16" Height="16" IsActive="True" />
                            <TextBlock loc:Localize.Text="Siliniyor…" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="DeleteModel_Click" loc:Localize.AutomationName="Sil…"
                                Visibility="{x:Bind ShowsDeleteButton}" IsEnabled="{x:Bind CanDelete}" ToolTipService.ToolTip="{x:Bind DeleteHelp}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock loc:Localize.Text="Sil…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralItem" Tag="general" loc:Localize.Content="Genel" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AppearanceItem" Tag="appearance" loc:Localize.Content="Görünüm">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ModelsItem" Tag="models" loc:Localize.Content="Modeller">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="Scroller" Padding="36,0,36,36">
                <Grid MaxWidth="860" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,24,0,0" VerticalAlignment="Top" />

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Margin="0,64,0,0" Spacing="4">
                        <TextBlock loc:Localize.Text="Dil" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,6" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xF2B7;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Arayüz dili" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Menüler ve sistem diyalogları uygulama yeniden açılınca güncellenir."
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="UiLanguageBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="UiLanguageBox_SelectionChanged"
                                          loc:Localize.AutomationName="Arayüz dili" />
                            </Grid>
                        </Border>

                        <TextBlock loc:Localize.Text="Altyazı ve çeviri" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE720;" FontSize="18" />
                                    <TextBlock Grid.Column="1" loc:Localize.Text="Konuşma dili" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <ComboBox x:Name="SpeechLanguageBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="SpeechLanguageBox_SelectionChanged"
                                          loc:Localize.AutomationName="Konuşma dili" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F0;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Altyazı modeli" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Daha doğru modeller daha yavaştır; ilk kullanımda indirilir." Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="ModelBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="ModelBox_SelectionChanged"
                                          loc:Localize.AutomationName="Altyazı modeli" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8C1;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Varsayılan çeviri modeli" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="“Çevir…” düğmesi bu modeli kullanır; seçim sonraki açılışlarda da korunur." Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="TranslationModelBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="TranslationModelBox_SelectionChanged"
                                          loc:Localize.AutomationName="Varsayılan çeviri modeli" />
                            </Grid>
                        </Border>

                        <TextBlock loc:Localize.Text="Konuşmacılar" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE716;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Konuşmacıları ayır" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Videoda birden çok kişi konuşuyorsa kimin ne dediğini ayır; ilk kullanımda küçük bir model indirilir."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch x:Name="DiarizeSwitch" Grid.Column="1" MinWidth="0" Toggled="DiarizeSwitch_Toggled"
                                              OnContent="" OffContent="" loc:Localize.AutomationName="Konuşmacıları ayır" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock loc:Localize.Text="Konuşmacı sayısı" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="34,0,0,0" />
                                <ComboBox x:Name="SpeakerCountBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="SpeakerCountBox_SelectionChanged"
                                          loc:Localize.AutomationName="Konuşmacı sayısı" />
                            </Grid>
                        </Border>

                        <TextBlock loc:Localize.Text="Harici LLM sunucusu (Yerel ağ)" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE968;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Ağdaki başka bir cihazın LLM sunucusunu kullan" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Çeviriyi yerel ağdaki başka bir bilgisayara veya Mac'e (LM Studio, Ollama, llama-server) yaptırır."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch x:Name="ExternalLlmSwitch" Grid.Column="1" MinWidth="0" Toggled="ExternalLlmSwitch_Toggled"
                                              OnContent="" OffContent="" loc:Localize.AutomationName="Ağdaki başka bir cihazın LLM sunucusunu kullan" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="34,0,0,0">
                                        <TextBlock loc:Localize.Text="Sunucu adresi (IP ve port)" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Örn. LM Studio için 192.168.1.50:1234, Ollama için 192.168.1.50:11434"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox x:Name="ExternalLlmUrlBox" MinWidth="220" VerticalAlignment="Center"
                                                 PlaceholderText="http://192.168.1.50:11434" TextChanged="ExternalLlmUrlBox_TextChanged"
                                                 loc:Localize.AutomationName="Sunucu adresi (IP ve port)" />
                                        <Button x:Name="TestExternalLlmButton" Click="TestExternalLlmButton_Click" VerticalAlignment="Center"
                                                loc:Localize.ToolTip="Sunucuya ping at ve modelleri getir" loc:Localize.AutomationName="Bağlantıyı test et">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                                <TextBlock loc:Localize.Text="Bağlantıyı test et" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <InfoBar x:Name="ExternalLlmTestBar" Margin="34,0,0,0" IsOpen="False" IsClosable="True" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="34,0,0,0">
                                    <TextBlock loc:Localize.Text="Uzak model adı (isteğe bağlı)" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock loc:Localize.Text="Boş bırakılırsa sunucuda yüklü olan ilk model otomatik algılanır."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ComboBox x:Name="ExternalLlmModelBox" IsEditable="True" MinWidth="220" VerticalAlignment="Center"
                                              PlaceholderText="gemma4:e4b" SelectionChanged="ExternalLlmModelBox_SelectionChanged"
                                              TextSubmitted="ExternalLlmModelBox_TextSubmitted" LostFocus="ExternalLlmModelBox_LostFocus"
                                              loc:Localize.AutomationName="Uzak model adı (isteğe bağlı)" />
                                    <Button x:Name="RefreshExternalModelsButton" Click="RefreshExternalModelsButton_Click" VerticalAlignment="Center"
                                            loc:Localize.ToolTip="Uzaktaki modelleri listele" loc:Localize.AutomationName="Uzaktaki modelleri listele">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="34,0,0,0">
                                    <TextBlock loc:Localize.Text="Asenkron çeviri (Sadece harici LLM ile)" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock loc:Localize.Text="Açıkken bu bilgisayar konuşmayı metne dökerken harici cihaz aynı anda çeviri yapar; kapalıyken sıralı çevrilir."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ExternalLlmAsyncSwitch" Grid.Column="1" MinWidth="0" Toggled="ExternalLlmAsyncSwitch_Toggled"
                                              OnContent="" OffContent="" loc:Localize.AutomationName="Asenkron çeviri (Sadece harici LLM ile)" />
                            </Grid>
                        </Border>

                        <TextBlock loc:Localize.Text="Gizlilik" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE709;" FontSize="18" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock loc:Localize.Text="Çevrimdışı mod" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock loc:Localize.Text="Açıkken internete hiç bağlanılmaz ve eksik modeller indirilmez. Ses ve metin hiçbir durumda dışarı gönderilmez."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch x:Name="OfflineSwitch" Grid.Column="1" MinWidth="0" Toggled="OfflineSwitch_Toggled"
                                              OnContent="" OffContent="" loc:Localize.AutomationName="Çevrimdışı mod" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearancePage" Margin="0,64,0,0" Spacing="4" Visibility="Collapsed">
                        <TextBlock loc:Localize.Text="Uygulama" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,6" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE771;" FontSize="18" />
                                    <TextBlock Grid.Column="1" loc:Localize.Text="Tema" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="ThemeBox_SelectionChanged"
                                          loc:Localize.AutomationName="Tema" />
                            </Grid>
                        </Border>

                        <TextBlock loc:Localize.Text="Video üstündeki altyazı" Style="{StaticResource SectionHeaderStyle}" />
                        <Border CornerRadius="8" Height="120" Margin="0,0,0,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF6B6B6B" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="PreviewArea" AutomationProperties.AccessibilityView="Raw">
                                <loc:OverlayLabel x:Name="PreviewLabel" Margin="16,0,16,18" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8D2;" FontSize="18" />
                                    <TextBlock Grid.Column="1" loc:Localize.Text="Yazı tipi" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <ComboBox x:Name="FontBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" MaxDropDownHeight="420"
                                          SelectionChanged="FontBox_SelectionChanged" loc:Localize.AutomationName="Yazı tipi" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock loc:Localize.Text="Boyut" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="34,0,0,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="SizeSlider" Width="200" VerticalAlignment="Center" StepFrequency="0.001" IsThumbToolTipEnabled="False"
                                            ValueChanged="SizeSlider_ValueChanged" loc:Localize.AutomationName="Boyut" />
                                    <TextBlock x:Name="SizeText" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock loc:Localize.Text="Yazı rengi" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="34,0,0,0" />
                                <Button x:Name="ColorButton" Grid.Column="1" Padding="6" loc:Localize.AutomationName="Yazı rengi" loc:Localize.ToolTip="Yazı rengini seç">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="ColorSwatch" Width="44" Height="20" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <TextBlock x:Name="ColorHex" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ColorPicker x:Name="TextColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                         ColorSpectrumShape="Ring" IsColorPreviewVisible="True" ColorChanged="TextColorPicker_ColorChanged" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock loc:Localize.Text="Arka plan" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="34,0,0,0" />
                                <ComboBox x:Name="BackgroundBox" Grid.Column="1" Style="{StaticResource CardControlStyle}" SelectionChanged="BackgroundBox_SelectionChanged"
                                          loc:Localize.AutomationName="Arka plan" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="OpacityTitle" loc:Localize.Text="Arka plan opaklığı" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="34,0,0,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OpacitySlider" Width="200" VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.01"
                                            IsThumbToolTipEnabled="False" ValueChanged="OpacitySlider_ValueChanged" loc:Localize.AutomationName="Arka plan opaklığı" />
                                    <TextBlock x:Name="OpacityText" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,8,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock loc:Localize.Text="Bu ayarlar yalnızca uygulamadaki önizlemeyi etkiler; dışa aktarılan altyazı dosyalarını değiştirmez."
                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Click="ResetOverlay_Click" loc:Localize.Content="Varsayılana döndür" />
                        </Grid>
                    </StackPanel>

                    <!-- Models -->
                    <StackPanel x:Name="ModelsPage" Margin="0,64,0,0" Spacing="4" Visibility="Collapsed">
                        <InfoBar x:Name="FreedBar" Severity="Success" IsClosable="True" IsOpen="False" Margin="0,8,0,0" />
                        <InfoBar x:Name="LoadErrorBar" Severity="Error" IsClosable="False" IsOpen="False" Margin="0,8,0,0" />
                        <TextBlock loc:Localize.Text="Altyazı modelleri" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,6" />
                        <ItemsControl x:Name="TranscriptionList" ItemTemplate="{StaticResource ModelRowTemplate}" IsTabStop="False" />
                        <StackPanel x:Name="DiarizationSection">
                            <TextBlock loc:Localize.Text="Konuşmacılar" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl x:Name="DiarizationList" ItemTemplate="{StaticResource ModelRowTemplate}" IsTabStop="False" />
                        </StackPanel>
                        <TextBlock loc:Localize.Text="Çeviri modelleri" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="TranslationList" ItemTemplate="{StaticResource ModelRowTemplate}" IsTabStop="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="1,8,0,0">
                            <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="TotalDisk" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
