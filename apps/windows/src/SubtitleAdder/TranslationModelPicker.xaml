<UserControl
    x:Class="SubtitleAdder.TranslationModelPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:SubtitleAdder.Core">
    <StackPanel Width="340" Spacing="10">
        <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                  MaxDropDownHeight="240" SelectionChanged="ProviderBox_SelectionChanged" />
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
        <Grid Height="240">
            <ListView x:Name="ModelList" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="ModelList_ItemClick" HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:TranslationModelChoice">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Title}" VerticalAlignment="Center" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <TextBlock x:Name="StatusText" Height="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   FontSize="12" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" />
            <Button x:Name="SettingsButton" Grid.Column="1" HorizontalAlignment="Right" Click="SettingsButton_Click" />
        </Grid>
    </StackPanel>
</UserControl>
