                      Link="Resources\Localizable.xcstrings"
                      LogicalName="SubtitleAdder.EngineKit.Localizable.xcstrings" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EngineKit.Tests" />
  </ItemGroup>

</Project>
