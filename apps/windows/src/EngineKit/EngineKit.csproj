<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SubtitleAdder.EngineKit</RootNamespace>
    <AssemblyName>SubtitleAdder.EngineKit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The macOS String Catalog is the single source of truth for EngineKit's user-facing strings. -->
