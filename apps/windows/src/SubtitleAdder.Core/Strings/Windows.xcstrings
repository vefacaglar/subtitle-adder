    "Videoları HDD'yi yormadan oynatmak ve ileri-geri sarmada anında açmak için seçili profil anahtarıyla şifrelenmiş olarak SSD/bellekte saklar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stores video chunks on SSD/RAM encrypted with the active profile key for instant seeking without wearing out mechanical HDDs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoları HDD'yi yormadan oynatmak ve ileri-geri sarmada anında açmak için seçili profil anahtarıyla şifrelenmiş olarak SSD/bellekte saklar."
          }
        }
      }
    },
    "Şifreli önbellek kullanımı: %@ / %lld GB": {
      "extractionState": "manual",
      "localizations": {
