    "Altyazı çıkarmak için sağ üstteki “Altyazı üret”e bas (Ctrl+Enter)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To extract subtitles, press “Generate Subtitles” at the top right (Ctrl+Enter)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazı çıkarmak için sağ üstteki “Altyazı üret”e bas (Ctrl+Enter)"
