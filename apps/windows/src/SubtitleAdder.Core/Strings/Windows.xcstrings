    "%@ boşaltıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ freed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boşaltıldı."
          }
        }
      }
    },
    "%@ indirilmemiş. Çevrimdışı mod açıkken model indirilemez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not downloaded. Models cannot be downloaded while offline mode is on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ indirilmemiş. Çevrimdışı mod açıkken model indirilemez."
          }
        }
      }
    },
    "%@ İşlemini Geri Al": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ İşlemini Geri Al"
