    "Altyazı dosyası seç (.srt, .vtt, .ass) — yeniden ses ayırmadan yükle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a subtitle file (.srt, .vtt, .ass) — load without re-extracting audio"
