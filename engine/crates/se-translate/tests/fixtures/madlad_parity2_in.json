[{"id": 1, "start": 0.0, "end": 1.25, "text": "Merhaba, nasılsın?"}, {"id": 2, "start": 1.25, "end": 2.5, "text": ""}, {"id": 3, "start": 2.5, "end": 3.75, "text": "Bugün hava çok güzel, dışarı çıkalım mı?", "speaker": 1}, {"id": 4, "start": 3.75, "end": 5.0, "text": "I can't believe you did that!"}, {"id": 5, "start": 5.0, "end": 6.25, "text": "Привет, как дела? Давно не виделись.", "words": [{"start": 0, "end": 1, "text": "x"}]}, {"id": 6, "start": 6.25, "end": 7.5, "text": "Oda numarası 42, Mehmet ile görüşün.", "speaker": 0}, {"id": 7, "start": 7.5, "end": 8.75, "text": "   "}, {"id": 8, "start": 8.75, "end": 10.0, "text": "こんにちは、元気ですか？"}, {"id": 9, "start": 10.0, "end": 11.25, "text": "Wait... what?! 😂", "speaker": 1}, {"id": 10, "start": 11.25, "end": 12.5, "text": "«Ne dedin sen?» diye bağırdı."}, {"id": 11, "start": 12.5, "end": 13.75, "text": "Line one\nline two"}, {"id": 12, "start": 13.75, "end": 15.0, "text": "- Evet.\n- Hayır!", "speaker": 0}, {"id": 13, "start": 15.0, "end": 16.25, "text": "OK."}, {"id": 14, "start": 16.25, "end": 17.5, "text": "The meeting starts at 9:30 a.m. on Friday, March 3rd."}, {"id": 15, "start": 17.5, "end": 18.75, "text": "Ich habe keine Ahnung, wovon du redest.", "speaker": 1}, {"id": 16, "start": 18.75, "end": 20.0, "text": "Bonjour tout le monde, ça va bien ?"}, {"id": 17, "start": 20.0, "end": 21.25, "text": "  leading and trailing spaces  "}, {"id": 18, "start": 21.25, "end": 22.5, "text": "Hmm.", "speaker": 0}, {"id": 19, "start": 22.5, "end": 23.75, "text": "Yarın sabah erkenden yola çıkacağız, hazır ol."}, {"id": 20, "start": 23.75, "end": 25.0, "text": "你好，你今天怎么样？"}, {"id": 21, "start": 25.0, "end": 26.25, "text": "*Seriously*, stop it.", "speaker": 1}, {"id": 22, "start": 26.25, "end": 27.5, "text": "Ve sonra... hiçbir şey olmadı."}, {"id": 23, "start": 27.5, "end": 28.75, "text": "1, 2, 3, go!"}, {"id": 24, "start": 28.75, "end": 30.0, "text": "\tTabbed text", "speaker": 0}, {"id": 25, "start": 30.0, "end": 31.25, "text": "Bu çok uzun bir cümle; içinde birçok virgül, noktalı virgül ve bağlaç var, ama yine de anlamlı olmalı çünkü altyazılar bazen böyle uzun olabilir."}, {"id": 26, "start": 31.25, "end": 32.5, "text": ""}]